[{"id":"hello","en":"hello","ipa":"həˈloʊ","pos":"interj","ru":["привет","здравствуйте"],"example":{"en":"Hello! I'm Anna.","ru":"Здравствуйте! Я Анна."},"picture":{"emoji":"👋"},"topics":["greetings"],"troubles":[],"unit":"a1.u01","level":"A1"},{"id":"hi","en":"hi","ipa":"haɪ","pos":"interj","ru":["привет"],"example":{"en":"Hi, Max! How are you?","ru":"Привет, Макс! Как дела?"},"note":"Hi — неформальное приветствие, hello подходит для любой ситуации.","topics":["greetings"],"troubles":[],"unit":"a1.u01","level":"A1"},{"id":"goodbye","en":"goodbye","ipa":"ɡʊdˈbaɪ","pos":"interj","ru":["до свидания"],"example":{"en":"Goodbye, Anna!","ru":"До свидания, Анна!"},"topics":["greetings"],"troubles":[],"unit":"a1.u01","level":"A1"},{"id":"bye","en":"bye","ipa":"baɪ","pos":"interj","ru":["пока"],"example":{"en":"Bye! See you tomorrow!","ru":"Пока! До завтра!"},"topics":["greetings"],"troubles":[],"unit":"a1.u01","level":"A1"},{"id":"see-you","en":"see you","ipa":"siː juː","pos":"phrase","ru":["увидимся","до встречи"],"example":{"en":"Bye, Li! See you!","ru":"Пока, Ли! Увидимся!"},"topics":["greetings"],"troubles":[],"unit":"a1.u01","level":"A1"},{"id":"tomorrow","en":"tomorrow","ipa":"təˈmɑːroʊ","pos":"adv","ru":["завтра"],"example":{"en":"See you tomorrow!","ru":"Увидимся завтра!"},"topics":[],"troubles":[],"unit":"a1.u01","level":"A1"},{"id":"good-morning","en":"good morning","ipa":"ɡʊd ˈmɔːrnɪŋ","pos":"phrase","ru":["доброе утро"],"example":{"en":"Good morning, Anna!","ru":"Доброе утро, Анна!"},"picture":{"emoji":"🌅"},"topics":["greetings"],"troubles":[],"unit":"a1.u01","level":"A1"},{"id":"good-afternoon","en":"good afternoon","ipa":"ɡʊd ˌæftɚˈnuːn","pos":"phrase","ru":["добрый день"],"example":{"en":"Good afternoon! I'm Tom.","ru":"Добрый день! Я Том."},"note":"Говорят примерно с полудня до шести вечера.","topics":["greetings"],"troubles":[],"unit":"a1.u01","level":"A1"},{"id":"good-evening","en":"good evening","ipa":"ɡʊd ˈiːvnɪŋ","pos":"phrase","ru":["добрый вечер"],"example":{"en":"Good evening! I'm Ivan.","ru":"Добрый вечер! Я Иван."},"topics":["greetings"],"troubles":[],"unit":"a1.u01","level":"A1"},{"id":"good-night","en":"good night","ipa":"ɡʊd naɪt","pos":"phrase","ru":["спокойной ночи"],"example":{"en":"Good night, Kate! See you tomorrow.","ru":"Спокойной ночи, Кейт! До завтра."},"note":"Это прощание, а не приветствие. Вечером при встрече говорят good evening.","picture":{"emoji":"🌙"},"topics":["greetings"],"troubles":[],"unit":"a1.u01","level":"A1"},{"id":"how-are-you","en":"how are you","ipa":"haʊ ɑːr juː","pos":"phrase","ru":["как дела?","как поживаете?"],"example":{"en":"Hi, Tom! How are you?","ru":"Привет, Том! Как дела?"},"note":"Обычно это просто часть приветствия. Отвечают коротко: Fine, thanks. And you?","topics":["greetings"],"troubles":[],"unit":"a1.u01","level":"A1"},{"id":"fine","en":"fine","ipa":"faɪn","pos":"adj","ru":["хорошо","нормально"],"example":{"en":"I'm fine, thanks. And you?","ru":"Хорошо, спасибо. А ты?"},"topics":["greetings"],"troubles":[],"unit":"a1.u01","level":"A1"},{"id":"not-bad","en":"not bad","ipa":"nɑːt bæd","pos":"phrase","ru":["неплохо"],"example":{"en":"Not bad, thank you!","ru":"Неплохо, спасибо!"},"topics":["greetings"],"troubles":[],"unit":"a1.u01","level":"A1"},{"id":"great","en":"great","ipa":"ɡreɪt","pos":"adj","ru":["отлично","отличный"],"example":{"en":"I'm great, thanks!","ru":"Отлично, спасибо!"},"topics":[],"troubles":[],"unit":"a1.u01","level":"A1"},{"id":"good","en":"good","ipa":"ɡʊd","pos":"adj","ru":["хороший","хорошо"],"example":{"en":"I'm good, thank you.","ru":"У меня всё хорошо, спасибо."},"forms":{"comparative":"better","superlative":"best"},"topics":[],"troubles":[],"unit":"a1.u01","level":"A1"},{"id":"thanks","en":"thanks","ipa":"θæŋks","pos":"interj","ru":["спасибо"],"example":{"en":"Thanks, Anna!","ru":"Спасибо, Анна!"},"topics":["greetings"],"troubles":["pron-th"],"unit":"a1.u01","level":"A1"},{"id":"thank-you","en":"thank you","ipa":"θæŋk juː","pos":"phrase","r