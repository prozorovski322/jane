s"],"troubles":[],"unit":"a1.u01","level":"A1"},{"id":"english","en":"English","ipa":"ˈɪŋɡlɪʃ","pos":"adj","ru":["английский","англичанин"],"example":{"en":"My English is not great.","ru":"Мой английский пока не очень."},"topics":["countries"],"troubles":[],"unit":"a1.u01","level":"A1"},{"id":"america","en":"America","ipa":"əˈmerɪkə","pos":"noun","ru":["Америка"],"example":{"en":"Kate is from America.","ru":"Кейт из Америки."},"topics":["countries"],"troubles":[],"unit":"a1.u01","level":"A1"},{"id":"american","en":"American","ipa":"əˈmerɪkən","pos":"adj","ru":["американский","американец"],"example":{"en":"Tom and Kate are American.","ru":"Том и Кейт американцы."},"topics":["countries"],"troubles":[],"unit":"a1.u01","level":"A1"},{"id":"spain","en":"Spain","ipa":"speɪn","pos":"noun","ru":["Испания"],"example":{"en":"Lucas is from Spain.","ru":"Лукас из Испании."},"topics":["countries"],"troubles":[],"unit":"a1.u01","level":"A1"},{"id":"spanish","en":"Spanish","ipa":"ˈspænɪʃ","pos":"adj","ru":["испанский","испанец"],"example":{"en":"Lucas is Spanish.","ru":"Лукас испанец."},"topics":["countries"],"troubles":[],"unit":"a1.u01","level":"A1"},{"id":"italy","en":"Italy","ipa":"ˈɪtəli","pos":"noun","ru":["Италия"],"example":{"en":"Marco is from Italy.","ru":"Марко из Италии."},"topics":["countries"],"troubles":[],"unit":"a1.u01","level":"A1"},{"id":"italian","en":"Italian","ipa":"ɪˈtæljən","pos":"adj","ru":["итальянский","итальянец"],"example":{"en":"Marco is Italian.","ru":"Марко итальянец."},"topics":["countries"],"troubles":[],"unit":"a1.u01","level":"A1"},{"id":"china","en":"China","ipa":"ˈtʃaɪnə","pos":"noun","ru":["Китай"],"example":{"en":"Li is from China.","ru":"Ли из Китая."},"topics":["countries"],"troubles":[],"unit":"a1.u01","level":"A1"},{"id":"chinese","en":"Chinese","ipa":"ˌtʃaɪˈniːz","pos":"adj","ru":["китайский","китаец"],"example":{"en":"Wei is Chinese.","ru":"Вэй китаец."},"topics":["countries"],"troubles":[],"unit":"a1.u01","level":"A1"},{"id":"job","en":"job","ipa":"dʒɑːb","pos":"noun","ru":["работа","должность"],"example":{"en":"I'm a designer. It's a new job.","ru":"Я дизайнер. Это новая работа."},"topics":["jobs"],"troubles":[],"unit":"a1.u01","level":"A1"},{"id":"what-do-you-do","en":"what do you do","ipa":"wʌt duː juː duː","pos":"phrase","ru":["кем вы работаете?","чем вы занимаетесь?"],"example":{"en":"What do you do? — I'm a nurse.","ru":"Кем вы работаете? — Я медсестра."},"note":"Устойчивый вопрос о профессии. Дословно «что вы делаете?», но спрашивают именно о работе.","topics":["jobs"],"troubles":[],"unit":"a1.u01","level":"A1"},{"id":"teacher","en":"teacher","ipa":"ˈtiːtʃɚ","pos":"noun","ru":["учитель","преподаватель"],"example":{"en":"Tom is a teacher.","ru":"Том учитель."},"picture":{"emoji":"🧑‍🏫"},"topics":["jobs"],"troubles":[],"unit":"a1.u01","level":"A1"},{"id":"student","en":"student","ipa":"ˈstuːdənt","pos":"noun","ru":["студент","студентка","учащийся"],"example":{"en":"I'm a student.","ru":"Я студент."},"picture":{"emoji":"🧑‍🎓"},"topics":["jobs"],"troubles":[],"unit":"a1.u01","level":"A1"},{"id":"doctor","en":"doctor","ipa":"ˈdɑːktɚ","pos":"noun","ru":["врач","доктор"],"example":{"en":"She's a doctor.","ru":"Она врач."},"picture":{"emoji":"🧑‍⚕️"},"topics":["jobs"],"troubles":[],"unit":"a1.u01","level":"A1"},{"id":"nurse","en":"nurse","ipa":"nɝːs","pos":"noun","ru":["медсестра","медбрат"],"example":{"en":"Elena is a nurse.","ru":"Елена медсестра."},"topics":["jobs"],"troubles":[],"unit":"a1.u01","level":"A1"},{"id":"engineer","en":"engineer","ipa":"ˌendʒɪˈnɪr","pos":"noun","ru":["инженер"],"example":{"en":"Ivan is an engineer.","ru":"Иван инженер."},"topics":["jobs"],"troubles":[],"unit":"a1.u01","level":"A1"},{"id":"designer","en":"designer","ipa":"dɪˈzaɪnɚ","pos":"noun","ru":["дизайнер"],"example":{"en":"Max is a designer.","ru":"Макс дизайнер."},"topics":["jobs"],"troubles":[],"unit":"a1.u01","level":"A1"},{"id":"manager","en":"manager","ipa":"ˈmænɪdʒɚ","pos":"noun","ru":["менеджер","руководит