# Accounts (Supabase). Copy to .env.local for local development; on Netlify set the same
# variables in Project configuration → Environment variables. Without them accounts are off.
# See docs/ACCOUNTS.md.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key
# Start with e-mail and password. Add google or custom:yandex only after
# configuring each provider in Supabase; otherwise its sign-in button will not work.
EXPO_PUBLIC_AUTH_PROVIDERS=
# Enable after installing supabase/templates/magic-link.html in Auth → Email Templates → Magic Link.
EXPO_PUBLIC_EMAIL_PASSWORDLESS=false
