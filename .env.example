# Accounts (Supabase). Copy to .env.local for local development; on Netlify set the same
# variables in Project configuration → Environment variables. Without them accounts are off.
# See docs/ACCOUNTS.md.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key
# Sign-in buttons besides e-mail: google, custom:yandex, custom:vk
EXPO_PUBLIC_AUTH_PROVIDERS=google,custom:yandex,custom:vk
