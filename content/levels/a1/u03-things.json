{
  "id": "a1.u03",
  "level": "A1",
  "order": 3,
  "title": { "en": "My things", "ru": "Мои вещи" },
  "description": "Говорим о вещах: что это, чьё это, один предмет или несколько. This, that, these, those, множественное число, артикли a, an, the.",
  "goals": [
    "Могу назвать вещи вокруг и спросить, что это.",
    "Могу показать на предмет вблизи и вдали: this, that, these, those.",
    "Могу сказать «один» и «много»: a book, two books, three boxes.",
    "Могу выбрать артикль a, an или the.",
    "Могу спросить и ответить, чья это вещь: Whose bag is this? — It is mine.",
    "Могу описать несколько своих вещей в коротком тексте."
  ],
  "grammar": ["a1.this-that", "a1.plurals", "a1.the"],
  "troubles": ["articles", "pron-th", "word-order"],
  "words": [
    { "id": "that", "en": "that", "ipa": "ðæt", "pos": "pron", "ru": ["то", "тот"], "example": { "en": "That is my bag.", "ru": "То моя сумка." }, "troubles": ["pron-th"] },
    { "id": "these", "en": "these", "ipa": "ðiːz", "pos": "pron", "ru": ["эти"], "example": { "en": "These are my keys.", "ru": "Это мои ключи." }, "troubles": ["pron-th"] },
    { "id": "those", "en": "those", "ipa": "ðoʊz", "pos": "pron", "ru": ["те"], "example": { "en": "Those are my glasses.", "ru": "То мои очки." }, "troubles": ["pron-th"] },
    { "id": "person", "en": "person", "ipa": "ˈpɝːsən", "pos": "noun", "ru": ["человек"], "example": { "en": "Tom is a nice person.", "ru": "Том — хороший человек." }, "forms": { "plural": "people" } },
    { "id": "people", "en": "people", "ipa": "ˈpiːpəl", "pos": "noun", "ru": ["люди"], "example": { "en": "Those people are friends.", "ru": "Эти люди — друзья." }, "note": "People — множественное число слова person. Глагол после people — are: people are.", "troubles": ["word-order"] },
    { "id": "notebook", "en": "notebook", "ipa": "ˈnoʊtbʊk", "pos": "noun", "ru": ["тетрадь", "блокнот"], "example": { "en": "This is my red notebook.", "ru": "Это моя красная тетрадь." }, "picture": { "emoji": "📓" }, "topics": ["things"] },
    { "id": "laptop", "en": "laptop", "ipa": "ˈlæptɑːp", "pos": "noun", "ru": ["ноутбук"], "example": { "en": "My laptop is new.", "ru": "Мой ноутбук новый." }, "topics": ["things"] },
    { "id": "wallet", "en": "wallet", "ipa": "ˈwɑːlɪt", "pos": "noun", "ru": ["кошелёк", "бумажник"], "example": { "en": "The wallet is brown.", "ru": "Кошелёк коричневый." }, "topics": ["things"] },
    { "id": "watch", "en": "watch", "ipa": "wɑːtʃ", "pos": "noun", "ru": ["наручные часы"], "example": { "en": "My watch is old.", "ru": "Мои часы старые." }, "note": "Watch — наручные часы. Настенные и настольные — clock. Во множественном числе — watches.", "picture": { "emoji": "⌚" }, "topics": ["things"] },
    { "id": "glasses", "en": "glasses", "ipa": "ˈɡlæsɪz", "pos": "noun", "ru": ["очки"], "example": { "en": "These are my glasses.", "ru": "Это мои очки." }, "note": "Glasses всегда во множественном числе: my glasses are new. Одни очки — a pair of glasses.", "picture": { "emoji": "👓" }, "topics": ["things"] },
    { "id": "passport", "en": "passport", "ipa": "ˈpæspɔːrt", "pos": "noun", "ru": ["паспорт (заграничный)"], "example": { "en": "This is my passport.", "ru": "Это мой паспорт." }, "picture": { "emoji": "🛂" }, "topics": ["things"] },
    { "id": "ticket", "en": "ticket", "ipa": "ˈtɪkɪt", "pos": "noun", "ru": ["билет"], "example": { "en": "This is my ticket.", "ru": "Это мой билет." }, "picture": { "emoji": "🎫" }, "topics": ["things"] },
    { "id": "card", "en": "card", "ipa": "kɑːrd", "pos": "noun", "ru": ["карта", "открытка"], "example": { "en": "This is my card.", "ru": "Это моя карта." }, "picture": { "emoji": "💳" }, "topics": ["things"] },
    { "id": "lamp", "en": "lamp", "ipa": "læmp", "pos": "noun", "ru": ["лампа"], "example": { "en": "A small lamp.", "ru": "Маленькая лампа." }, "topics": ["things"] },
    { "id": "picture", "en": "picture", "ipa": "ˈpɪktʃɚ", "pos": "noun", "ru": ["картина", "картинка"], "example": { "en": "That is a nice picture.", "ru": "То красивая картина." }, "picture": { "emoji": "🖼️" }, "topics": ["things"] },
    { "id": "mirror", "en": "mirror", "ipa": "ˈmɪrɚ", "pos": "noun", "ru": ["зеркало"], "example": { "en": "A big mirror.", "ru": "Большое зеркало." }, "picture": { "emoji": "🪞" }, "topics": ["things"] },
    { "id": "headphones", "en": "headphones", "ipa": "ˈhedfoʊnz", "pos": "noun", "ru": ["наушники"], "example": { "en": "These are my headphones.", "ru": "Это мои наушники." }, "note": "Как и glasses, слово headphones — всегда множественное число.", "picture": { "emoji": "🎧" }, "topics": ["things"] },
    { "id": "magazine", "en": "magazine", "ipa": "ˈmæɡəˌziːn", "pos": "noun", "ru": ["журнал"], "example": { "en": "This is a magazine.", "ru": "Это журнал." }, "note": "Ударение на первый слог: MAG-a-zine. Magazine — это именно журнал, а не склад.", "picture": { "emoji": "📰" }, "topics": ["things"] },
    { "id": "newspaper", "en": "newspaper", "ipa": "ˈnuːzˌpeɪpɚ", "pos": "noun", "ru": ["газета"], "example": { "en": "That is a newspaper.", "ru": "То газета." }, "topics": ["things"] },
    { "id": "nice", "en": "nice", "ipa": "naɪs", "pos": "adj", "ru": ["приятный", "хороший", "милый"], "example": { "en": "That is a nice bag.", "ru": "То хорошая сумка." }, "note": "Nice — «приятный, милый». Подходит и для вещей, и для людей." },
    { "id": "beautiful", "en": "beautiful", "ipa": "ˈbjuːtɪfəl", "pos": "adj", "ru": ["красивый"], "example": { "en": "That is a beautiful picture.", "ru": "То красивая картина." }, "note": "Ударение на первый слог: BEAU-ti-ful." },
    { "id": "favorite", "en": "favorite", "ipa": "ˈfeɪvərɪt", "pos": "adj", "ru": ["любимый"], "example": { "en": "This is my favorite book.", "ru": "Это моя любимая книга." }, "note": "В британском варианте пишется favourite." },
    { "id": "bad", "en": "bad", "ipa": "bæd", "pos": "adj", "ru": ["плохой"], "example": { "en": "That is a bad picture.", "ru": "То плохая картина." } },
    { "id": "mine", "en": "mine", "ipa": "maɪn", "pos": "pron", "ru": ["мой (без существительного)"], "example": { "en": "This bag is mine.", "ru": "Эта сумка моя." }, "note": "Mine стоит без существительного: It is mine. Вместе с существительным — my: my bag." },
    { "id": "yours", "en": "yours", "ipa": "jɔːrz", "pos": "pron", "ru": ["твой, ваш (без существительного)"], "example": { "en": "Is this bag yours?", "ru": "Эта сумка твоя?" } },
    { "id": "whose", "en": "whose", "ipa": "huːz", "pos": "pron", "ru": ["чей"], "example": { "en": "Whose bag is this?", "ru": "Чья это сумка?" }, "note": "Whose пишется с w, но читается как [huːz], как who + z." },
    { "id": "or", "en": "or", "ipa": "ɔːr", "pos": "conj", "ru": ["или"], "example": { "en": "Is it a pen or a pencil?", "ru": "Это ручка или карандаш?" } },
    { "id": "something", "en": "something", "ipa": "ˈsʌmθɪŋ", "pos": "pron", "ru": ["что-то"], "example": { "en": "It's something new.", "ru": "Это что-то новое." }, "topics": ["grammar"] },
    { "id": "anything", "en": "anything", "ipa": "ˈeniθɪŋ", "pos": "pron", "ru": ["что-нибудь", "ничего (в отрицании)"], "example": { "en": "Anything new?", "ru": "Что-нибудь новое?" }, "topics": ["grammar"] },
    { "id": "nothing", "en": "nothing", "ipa": "ˈnʌθɪŋ", "pos": "pron", "ru": ["ничего"], "example": { "en": "It's nothing.", "ru": "Ничего страшного." }, "note": "С nothing второй not не нужен: I saw nothing.", "topics": ["grammar"] },
    { "id": "everything", "en": "everything", "ipa": "ˈevriθɪŋ", "pos": "pron", "ru": ["всё"], "example": { "en": "Everything is new.", "ru": "Всё новое." }, "topics": ["grammar"] },
    { "id": "list", "en": "list", "ipa": "lɪst", "pos": "noun", "ru": ["список"], "example": { "en": "Here is my list.", "ru": "Вот мой список." }, "topics": ["things"] },
    { "id": "piece", "en": "piece", "ipa": "piːs", "pos": "noun", "ru": ["кусок", "кусочек"], "example": { "en": "This is a big piece.", "ru": "Это большой кусок." }, "topics": ["things"] },
    { "id": "paper", "en": "paper", "ipa": "ˈpeɪpɚ", "pos": "noun", "ru": ["бумага"], "example": { "en": "My book is old, and the paper is yellow.", "ru": "Моя книга старая, и бумага жёлтая." }, "topics": ["things"] },
    { "id": "page", "en": "page", "ipa": "peɪdʒ", "pos": "noun", "ru": ["страница"], "example": { "en": "It's page ten.", "ru": "Это страница десять." }, "topics": ["study"] },
    { "id": "note", "en": "note", "ipa": "noʊt", "pos": "noun", "ru": ["записка", "заметка"], "example": { "en": "This is a note from my mother.", "ru": "Это записка от мамы." }, "topics": ["things"] },
    { "id": "put", "en": "put", "ipa": "pʊt", "pos": "verb", "ru": ["класть", "ставить"], "example": { "en": "Put your bag here.", "ru": "Положи сумку сюда." }, "forms": { "third": "puts", "ing": "putting" }, "note": "Неправильный глагол: put — put — put.", "topics": ["actions"] }
  ],
  "texts": [
    {
      "id": "a1.u03.whose-bag",
      "kind": "dialogue",
      "genre": "conversation",
      "title": { "en": "Whose bag is this?", "ru": "Чья это сумка?" },
      "speakers": [
        { "id": "anna", "name": "Anna", "voice": "female" },
        { "id": "tom", "name": "Tom", "voice": "male" }
      ],
      "lines": [
        { "speaker": "anna", "en": "Tom, whose bag is this?", "ru": "Том, чья это сумка?" },
        { "speaker": "tom", "en": "It is not my bag. Is it yours?", "ru": "Это не моя сумка. Это твоя?" },
        { "speaker": "anna", "en": "No, it isn't mine. It is not my bag.", "ru": "Нет, она не моя. Это не моя сумка." },
        { "speaker": "tom", "en": "Whose is it? Is it Max's bag?", "ru": "Чья она? Это сумка Макса?" },
        { "speaker": "anna", "en": "Yes, it is. This is his passport, and those are his keys.", "ru": "Да. Это его паспорт, а то его ключи." },
        { "speaker": "tom", "en": "Great! Thank you, Anna!", "ru": "Отлично! Спасибо, Анна!" }
      ]
    },
    {
      "id": "a1.u03.my-things",
      "kind": "reading",
      "genre": "profile",
      "title": { "en": "My things", "ru": "Мои вещи" },
      "lines": [
        { "en": "This is my desk. These are my things.", "ru": "Это мой письменный стол. Это мои вещи." },
        { "en": "This is my laptop. It is new. That is my phone. It is black.", "ru": "Это мой ноутбук. Он новый. То мой телефон. Он чёрный." },
        { "en": "Those are my keys. These are my glasses. They are old, but they are nice.", "ru": "То мои ключи. Это мои очки. Они старые, но хорошие." },
        { "en": "The notebook is my favorite thing. It is red.", "ru": "Тетрадь — моя любимая вещь. Она красная." }
      ]
    }
  ],
  "lessons": [
    {
      "id": "a1.u03.l01",
      "kind": "vocabulary",
      "title": "Что в моей сумке?",
      "exercises": [
        { "id": "a1.u03.l01.e01", "type": "picture_choice", "mode": "picture-to-word", "word": "watch", "distractors": ["ticket", "card"], "hint": "Её носят на руке.", "explanation": "Watch — «наручные часы». Настенные часы называются clock." },
        { "id": "a1.u03.l01.e02", "type": "picture_choice", "mode": "word-to-picture", "word": "glasses", "distractors": ["headphones", "mirror"], "hint": "Их носят на носу.", "explanation": "Glasses — «очки». Слово всегда во множественном числе." },
        { "id": "a1.u03.l01.e03", "type": "picture_choice", "mode": "picture-to-word", "word": "passport", "distractors": ["ticket", "card"], "hint": "Его показывают на границе.", "explanation": "Passport — «паспорт» для поездок за границу: [ˈpæspɔːrt]." },
        { "id": "a1.u03.l01.e04", "type": "picture_choice", "mode": "picture-to-word", "word": "headphones", "distractors": ["glasses", "notebook"], "hint": "В них слушают музыку.", "explanation": "Headphones — «наушники»: head («голова») + phones." },
        { "id": "a1.u03.l01.e05", "type": "translate_choice", "from": "en", "text": "notebook", "options": ["тетрадь, блокнот", "ноутбук", "книга"], "answer": 0, "hint": "Это не компьютер.", "explanation": "Notebook — «тетрадь, блокнот». Ноутбук — laptop.", "troubles": ["false-friends"] },
        { "id": "a1.u03.l01.e06", "type": "translate_choice", "from": "ru", "text": "ноутбук", "options": ["laptop", "notebook", "clock"], "answer": 0, "hint": "Он лежит на коленях.", "explanation": "Laptop — «ноутбук». Notebook — «тетрадь».", "troubles": ["false-friends"] },
        { "id": "a1.u03.l01.e07", "type": "match_pairs", "pairs": [{ "en": "wallet", "ru": "кошелёк" }, { "en": "ticket", "ru": "билет" }, { "en": "card", "ru": "карта" }, { "en": "lamp", "ru": "лампа" }, { "en": "mirror", "ru": "зеркало" }], "hint": "Wallet и ticket лежат в сумке.", "explanation": "Wallet — «кошелёк», ticket — «билет», card — «карта», lamp — «лампа», mirror — «зеркало»." },
        { "id": "a1.u03.l01.e08", "type": "match_pairs", "pairs": [{ "en": "magazine", "ru": "журнал" }, { "en": "newspaper", "ru": "газета" }, { "en": "picture", "ru": "картина" }, { "en": "person", "ru": "человек" }, { "en": "people", "ru": "люди" }], "hint": "Magazine — не «магазин».", "explanation": "Magazine — «журнал», newspaper — «газета», picture — «картина», person — «человек», people — «люди».", "troubles": ["false-friends"] },
        { "id": "a1.u03.l01.e09", "type": "match_pairs", "pairs": [{ "en": "nice", "ru": "приятный" }, { "en": "beautiful", "ru": "красивый" }, { "en": "bad", "ru": "плохой" }, { "en": "favorite", "ru": "любимый" }, { "en": "new", "ru": "новый" }], "hint": "Bad и nice — противоположные слова.", "explanation": "Nice — «приятный», beautiful — «красивый», bad — «плохой», favorite — «любимый», new — «новый»." },
        { "id": "a1.u03.l01.e90", "type": "match_pairs", "pairs": [{ "en": "something", "ru": "что-то" }, { "en": "anything", "ru": "что-нибудь" }, { "en": "nothing", "ru": "ничего" }, { "en": "everything", "ru": "всё" }, { "en": "list", "ru": "список" }, { "en": "piece", "ru": "кусок" }], "hint": "Новые слова.", "explanation": "Something — что-то, anything — что-нибудь, nothing — ничего, everything — всё, list — список, piece — кусок." },
        { "id": "a1.u03.l01.e91", "type": "match_pairs", "pairs": [{ "en": "paper", "ru": "бумага" }, { "en": "page", "ru": "страница" }, { "en": "note", "ru": "записка" }, { "en": "put", "ru": "класть" }], "hint": "Новые слова.", "explanation": "Paper — бумага, page — страница, note — записка, put — класть." },
        { "id": "a1.u03.l01.e10", "type": "listen_choice", "audio": "ticket", "question": "Какое слово вы слышите?", "options": ["ticket", "picture", "wallet"], "answer": 0, "hint": "Слово из двух слогов, в начале звук [t].", "explanation": "Ticket — «билет»: [ˈtɪkɪt]. Ударение на первый слог." },
        { "id": "a1.u03.l01.e11", "type": "listen_dictation", "text": "wallet", "hint": "Шесть букв.", "explanation": "Wallet — «кошелёк». Читается [ˈwɑːlɪt], не «валет»." },
        { "id": "a1.u03.l01.e12", "type": "type_translation", "from": "ru", "text": "зеркало", "answers": ["mirror"], "hint": "Шесть букв.", "explanation": "Mirror — «зеркало»: [ˈmɪrɚ]. Две r в слове." },
        { "id": "a1.u03.l01.e13", "type": "fill_gap", "text": "This is my ___ book.", "translation": "Это моя любимая книга.", "answers": [["favorite"]], "options": ["favorite", "or", "bad"], "hint": "Книга, которая нравится больше других.", "explanation": "Favorite — «любимый»: my favorite book." },
        { "id": "a1.u03.l01.e14", "type": "word_stress", "word": "beautiful", "syllables": ["beau", "ti", "ful"], "stress": 0, "hint": "Первый слог — beau.", "explanation": "BEAU-ti-ful — ударение на первый слог." }
      ]
    },
    {
      "id": "a1.u03.l02",
      "kind": "grammar",
      "title": "This и that: близко и далеко",
      "grammar": "a1.this-that",
      "exercises": [
        { "id": "a1.u03.l02.e01", "type": "fill_gap", "text": "___ is my phone.", "translation": "Это мой телефон (он рядом).", "answers": [["This"]], "options": ["This", "That", "These"], "hint": "Один предмет и он близко.", "explanation": "This is my phone: this — один предмет рядом.", "grammar": ["a1.this-that"] },
        { "id": "a1.u03.l02.e02", "type": "fill_gap", "text": "___ is my bag.", "translation": "То моя сумка (она далеко).", "answers": [["That"]], "options": ["This", "That", "Those"], "hint": "Один предмет и он далеко.", "explanation": "That is my bag: that — один предмет вдали.", "grammar": ["a1.this-that"] },
        { "id": "a1.u03.l02.e03", "type": "fill_gap", "text": "What is ___?", "translation": "Что это? (рядом)", "answers": [["this"]], "options": ["this", "that", "these"], "hint": "Предмет рядом.", "explanation": "What is this? — вопрос о предмете рядом.", "grammar": ["a1.this-that"] },
        { "id": "a1.u03.l02.e04", "type": "translate_choice", "from": "en", "text": "That is a nice picture.", "options": ["То красивая картина.", "Это красивая картина.", "То плохая картина."], "answer": 0, "hint": "Nice — «приятный».", "explanation": "That is a nice picture — «то красивая картина». That — вдали." },
        { "id": "a1.u03.l02.e05", "type": "translate_choice", "from": "ru", "text": "То газета.", "options": ["That is a newspaper.", "This is a newspaper.", "That is a magazine."], "answer": 0, "hint": "То — далеко.", "explanation": "That is a newspaper — «то газета». Newspaper — газета, magazine — журнал." },
        { "id": "a1.u03.l02.e06", "type": "error_correction", "text": "This is my keys.", "wrong": "This is", "correction": "These are", "options": ["These are", "That is", "Those is"], "hint": "Ключей несколько.", "explanation": "These are my keys. Несколько предметов рядом — these are.", "grammar": ["a1.this-that"] },
        { "id": "a1.u03.l02.e07", "type": "tiles", "from": "ru", "text": "Что это?", "answer": "What is this?", "distractors": ["are", "that"], "hint": "Предмет рядом.", "explanation": "What is this? — «Что это?».", "grammar": ["a1.this-that"] },
