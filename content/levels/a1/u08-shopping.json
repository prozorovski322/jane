    { "id": "him", "en": "him", "ipa": "hɪm", "pos": "pron", "ru": ["ему", "его"], "example": { "en": "The coat is for him.", "ru": "Пальто для него." }, "topics": ["pronouns"] },
    { "id": "her#pron", "en": "her", "ipa": "hɝː", "pos": "pron", "ru": ["ей", "её"], "example": { "en": "I like her.", "ru": "Она мне нравится." }, "topics": ["pronouns"] },
    { "id": "us", "en": "us", "ipa": "ʌs", "pos": "pron", "ru": ["нам", "нас"], "example": { "en": "Give us the menu, please.", "ru": "Дайте нам меню, пожалуйста." }, "topics": ["pronouns"] },
    { "id": "them", "en": "them", "ipa": "ðem", "pos": "pron", "ru": ["им", "их"], "example": { "en": "I like them.", "ru": "Они мне нравятся." }, "troubles": ["pron-th"], "topics": ["pronouns"] },
    { "id": "sell", "en": "sell", "ipa": "sel", "pos": "verb", "ru": ["продавать"], "example": { "en": "They sell shoes here.", "ru": "Здесь продают обувь." }, "forms": { "third": "sells" }, "topics": ["work"] },
