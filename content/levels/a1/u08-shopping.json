    { "id": "give", "en": "give", "ipa": "ɡɪv", "pos": "verb", "ru": ["давать"], "example": { "en": "Give me the bag, please.", "ru": "Дайте мне сумку, пожалуйста." }, "forms": { "third": "gives" }, "topics": ["shopping"] },
    { "id": "how-much", "en": "how much", "ipa": "haʊ mʌtʃ", "pos": "phrase", "ru": ["сколько (стоит)"], "example": { "en": "How much is this shirt?", "ru": "Сколько стоит эта рубашка?" }, "topics": ["shopping"] },
    { "id": "can", "en": "can", "ipa": "kæn", "pos": "modal", "ru": ["мочь", "можно"], "example": { "en": "Can I pay by card?", "ru": "Можно заплатить картой?" }, "note": "Can не получает -s: he can, she can. После can глагол без to.", "topics": ["shopping"] },
