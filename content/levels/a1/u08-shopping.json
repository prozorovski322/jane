    { "id": "size", "en": "size", "ipa": "saɪz", "pos": "noun", "ru": ["размер"], "example": { "en": "I need a small size.", "ru": "Мне нужен маленький размер." }, "topics": ["clothes"] },
    { "id": "wear", "en": "wear", "ipa": "wer", "pos": "verb", "ru": ["носить (одежду)"], "example": { "en": "I wear a coat every day.", "ru": "Я ношу пальто каждый день." }, "forms": { "third": "wears" }, "topics": ["clothes"] },
