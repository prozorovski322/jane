  "texts": [
    {
      "id": "a1.u08.shop",
      "kind": "dialogue",
      "genre": "conversation",
      "title": { "en": "In the shop", "ru": "В магазине" },
      "speakers": [
        { "id": "anna", "name": "Anna", "voice": "female" },
        { "id": "tom", "name": "Tom", "voice": "male" }
      ],
      "lines": [
        { "speaker": "anna", "en": "Excuse me, how much is this shirt?", "ru": "Извините, сколько стоит эта рубашка?" },
        { "speaker": "tom", "en": "It is twenty euros.", "ru": "Двадцать евро." },
        { "speaker": "anna", "en": "And how much are these jeans?", "ru": "А сколько стоят эти джинсы?" },
        { "speaker": "tom", "en": "They are forty euros. They are cheap.", "ru": "Сорок евро. Они недорогие." },
        { "speaker": "anna", "en": "Can I try them on?", "ru": "Можно их примерить?" },
        { "speaker": "tom", "en": "Yes, you can. What size do you need?", "ru": "Да, можно. Какой размер вам нужен?" },
        { "speaker": "anna", "en": "I need a small size. I like them. Can I pay by card?", "ru": "Мне нужен маленький размер. Они мне нравятся. Можно заплатить картой?" },
        { "speaker": "tom", "en": "Yes, you can. Or you can pay with cash.", "ru": "Да, можно. Или можно заплатить наличными." }
      ]
    },
    {
      "id": "a1.u08.max-coat",
      "kind": "reading",
      "genre": "article",
      "title": { "en": "Max needs a coat", "ru": "Максу нужно пальто" },
      "lines": [
        { "en": "Max needs a new coat. In the shop the coat costs two hundred euros. It is expensive, and he doesn't buy it.", "ru": "Максу нужно новое пальто. В магазине пальто стоит двести евро. Оно дорогое, и он его не покупает." },
        { "en": "On Saturday he goes to the market. There is a nice coat there. It costs fifty euros, and he buys it.", "ru": "В субботу он идёт на рынок. Там есть хорошее пальто. Оно стоит пятьдесят евро, и он его покупает." },
        { "en": "He wears the coat every day. His sister likes it, and she wants a coat too. She goes to the market with him.", "ru": "Он носит пальто каждый день. Его сестре оно нравится, и она тоже хочет пальто. Она идёт на рынок вместе с ним." }
      ]
    }
  ],
  "lessons": [
    {
      "id": "a1.u08.l01",
      "kind": "vocabulary",
      "title": "Одежда и деньги",
