    { "id": "poor", "en": "poor", "ipa": "pʊr", "pos": "adj", "ru": ["бедный"], "example": { "en": "They are poor, but happy.", "ru": "Они бедные, но счастливые." }, "topics": ["life"] },
    { "id": "real", "en": "real", "ipa": "riːl", "pos": "adj", "ru": ["настоящий"], "example": { "en": "Is it real?", "ru": "Это настоящее?" }, "topics": ["adjectives"] },
