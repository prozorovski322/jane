        { "id": "a1.u08.l01.e02", "type": "match_pairs", "pairs": [{ "en": "money", "ru": "деньги" }, { "en": "cash", "ru": "наличные" }, { "en": "euro", "ru": "евро" }, { "en": "dollar", "ru": "доллар" }, { "en": "price", "ru": "цена" }], "hint": "Euro и dollar — виды денег.", "explanation": "Money — деньги, cash — наличные, euro — евро, dollar — доллар, price — цена." },
        { "id": "a1.u08.l01.e03", "type": "match_pairs", "pairs": [{ "en": "buy", "ru": "покупать" }, { "en": "pay", "ru": "платить" }, { "en": "cost", "ru": "стоить" }, { "en": "wear", "ru": "носить" }, { "en": "need", "ru": "нуждаться" }], "hint": "Три глагола — про деньги.", "explanation": "Buy — покупать, pay — платить, cost — стоить, wear — носить, need — нуждаться." },
        { "id": "a1.u08.l01.e90", "type": "match_pairs", "pairs": [{ "en": "sell", "ru": "продавать" }, { "en": "rich", "ru": "богатый" }, { "en": "poor", "ru": "бедный" }, { "en": "real", "ru": "настоящий" }, { "en": "perfect", "ru": "идеальный" }], "hint": "Новые слова.", "explanation": "Sell — продавать, rich — богатый, poor — бедный, real — настоящий, perfect — идеальный." },
        { "id": "a1.u08.l01.e91", "type": "match_pairs", "pairs": [{ "en": "shape", "ru": "форма" }, { "en": "purple", "ru": "фиолетовый" }, { "en": "if", "ru": "если" }], "hint": "Новые слова.", "explanation": "Shape — форма, purple — фиолетовый, if — если." },
        { "id": "a1.u08.l01.e04", "type": "picture_choice", "mode": "picture-to-word", "word": "coat", "distractors": ["shirt", "dress"], "hint": "Её носят зимой.", "explanation": "Coat — «пальто»: [koʊt]." },
        { "id": "a1.u08.l01.e05", "type": "picture_choice", "mode": "picture-to-word", "word": "jeans", "distractors": ["shirt", "shoes"], "hint": "Их носят на ногах и они обычно синие.", "explanation": "Jeans — «джинсы»: [dʒiːnz]." },
        { "id": "a1.u08.l01.e06", "type": "picture_choice", "mode": "word-to-picture", "word": "dress", "distractors": ["coat", "shirt"], "hint": "Женская одежда.", "explanation": "Dress — «платье»: [dres]." },
        { "id": "a1.u08.l01.e07", "type": "translate_choice", "from": "ru", "text": "дорогой", "options": ["expensive", "cheap", "small"], "answer": 0, "hint": "Цена высокая.", "explanation": "Expensive — «дорогой», cheap — «дешёвый»." },
        { "id": "a1.u08.l01.e08", "type": "translate_choice", "from": "en", "text": "cheap", "options": ["дешёвый", "дорогой", "красивый"], "answer": 0, "hint": "Цена низкая.", "explanation": "Cheap [tʃiːp] — «дешёвый»." },
        { "id": "a1.u08.l01.e09", "type": "listen_choice", "audio": "shirt", "question": "Что вы слышите?", "options": ["shirt", "shoes", "dress"], "answer": 0, "hint": "Гласный как в work.", "explanation": "Shirt [ʃɝːt] — «рубашка».", "troubles": ["pron-vowels"] },
        { "id": "a1.u08.l01.e10", "type": "listen_dictation", "text": "The coat is expensive.", "hint": "Четыре слова.", "explanation": "The coat is expensive — «пальто дорогое»." },
        { "id": "a1.u08.l01.e11", "type": "type_translation", "from": "ru", "text": "деньги", "answers": ["money"], "hint": "Пять букв.", "explanation": "Money [ˈmʌni] — «деньги». Несчитаемое слово." },
        { "id": "a1.u08.l01.e12", "type": "type_translation", "from": "ru", "text": "размер", "answers": ["size"], "hint": "Четыре буквы.", "explanation": "Size [saɪz] — «размер»." },
        { "id": "a1.u08.l01.e13", "type": "fill_gap", "text": "I ___ a coat every day.", "translation": "Я ношу пальто каждый день.", "answers": [["wear"]], "options": ["wear", "buy", "cost"], "hint": "Одежду носят.", "explanation": "I wear a coat every day. Wear — «носить»." },
        { "id": "a1.u08.l01.e14", "type": "word_stress", "word": "expensive", "syllables": ["ex", "pen", "sive"], "stress": 1, "hint": "Ударение в середине.", "explanation": "ex-PEN-sive — ударение на второй слог." }
      ]
    },
    {
      "id": "a1.u08.l02",
      "kind": "grammar",
      "title": "Сколько стоит?",
      "grammar": "a1.how-much",
      "exercises": [
        { "id": "a1.u08.l02.e01", "type": "fill_gap", "text": "How ___ is this shirt?", "translation": "Сколько стоит эта рубашка?", "answers": [["much"]], "options": ["much", "many", "old"], "hint": "Для цены.", "explanation": "How much is this shirt? Цену спрашивают с How much.", "grammar": ["a1.how-much"] },
        { "id": "a1.u08.l02.e02", "type": "fill_gap", "text": "How much ___ these jeans?", "translation": "Сколько стоят эти джинсы?", "answers": [["are"]], "options": ["are", "is", "does"], "hint": "Jeans — множественное число.", "explanation": "How much are these jeans? Jeans — как «они».", "grammar": ["a1.how-much"], "troubles": ["word-order"] },
        { "id": "a1.u08.l02.e03", "type": "fill_gap", "text": "How ___ shirts do you have?", "translation": "Сколько у вас рубашек?", "answers": [["many"]], "options": ["many", "much", "old"], "hint": "Считаем штуки.", "explanation": "How many shirts do you have? Для количества штук — How many.", "grammar": ["a1.how-much"] },
        { "id": "a1.u08.l02.e04", "type": "fill_gap", "text": "The coat ___ two hundred euros.", "translation": "Пальто стоит двести евро.", "answers": [["costs"]], "options": ["costs", "cost", "is cost"], "hint": "О вещи — с -s.", "explanation": "The coat costs two hundred euros. С it — cost с -s.", "grammar": ["a1.how-much", "a1.present-simple"], "troubles": ["tenses"] },
        { "id": "a1.u08.l02.e05", "type": "fill_gap", "text": "How much does the bag ___?", "translation": "Сколько стоит сумка?", "answers": [["cost"]], "options": ["cost", "costs", "costing"], "hint": "После does глагол без окончания.", "explanation": "How much does the bag cost? После does — cost без -s.", "grammar": ["a1.how-much", "a1.present-simple-questions"] },
        { "id": "a1.u08.l02.e06", "type": "error_correction", "text": "How many is this shirt?", "wrong": "many", "correction": "much", "options": ["much", "old", "far"], "hint": "Цена — не количество.", "explanation": "How much is this shirt? Цену спрашивают с How much.", "grammar": ["a1.how-much"] },
        { "id": "a1.u08.l02.e07", "type": "error_correction", "text": "How much costs the bag?", "wrong": "costs the bag", "correction": "does the bag cost", "options": ["does the bag cost", "is the bag cost", "do the bag costs"], "hint": "Нужен вспомогательный глагол.", "explanation": "How much does the bag cost? В вопросе с cost нужен does.", "grammar": ["a1.how-much"], "troubles": ["word-order"] },
