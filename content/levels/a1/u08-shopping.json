    { "id": "shape", "en": "shape", "ipa": "ʃeɪp", "pos": "noun", "ru": ["форма"], "example": { "en": "I like the shape of this bag.", "ru": "Мне нравится форма этой сумки." }, "topics": ["things"] },
    { "id": "purple", "en": "purple", "ipa": "ˈpɝːpəl", "pos": "adj", "ru": ["фиолетовый"], "example": { "en": "Her dress is purple.", "ru": "У неё фиолетовое платье." }, "topics": ["colors"] },
    { "id": "if", "en": "if", "ipa": "ɪf", "pos": "conj", "ru": ["если"], "example": { "en": "If you like it, buy it.", "ru": "Если тебе нравится, купи." }, "topics": ["grammar"] }
