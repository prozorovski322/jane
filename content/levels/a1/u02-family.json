        { "id": "a1.u02.l03.e02", "type": "fill_gap", "text": "This is Tom. ___ sister is Anna.", "translation": "Это Том. Его сестра — Анна.", "answers": [["His"]], "options": ["His", "Her", "Their"], "hint": "Том — мужчина.", "explanation": "His sister — «его сестра»: владелец Том (мужчина).", "grammar": ["a1.possessives"] },
        { "id": "a1.u02.l03.e03", "type": "fill_gap", "text": "This is Anna. ___ brother is Tom.", "translation": "Это Анна. Её брат — Том.", "answers": [["Her"]], "options": ["Her", "His", "Our"], "hint": "Анна — женщина.", "explanation": "Her brother — «её брат»: владелица Анна (женщина).", "grammar": ["a1.possessives"] },
        { "id": "a1.u02.l03.e04", "type": "fill_gap", "text": "We are from Kazan. ___ family is big.", "translation": "Мы из Казани. Наша семья большая.", "answers": [["Our"]], "options": ["Our", "Your", "Their"], "hint": "Мы — наша.", "explanation": "Our family — «наша семья»: our — «наш» для we.", "grammar": ["a1.possessives"] },
        { "id": "a1.u02.l03.e05", "type": "fill_gap", "text": "Tom and Anna are friends. ___ parents are from Italy.", "translation": "Том и Анна — друзья. Их родители из Италии.", "answers": [["Their"]], "options": ["Their", "Her", "Our"], "hint": "Несколько людей — они.", "explanation": "Their parents — «их родители». Their — «их» для they.", "grammar": ["a1.possessives"], "troubles": ["pron-th"] },
        { "id": "a1.u02.l03.e06", "type": "error_correction", "text": "This is a my brother.", "wrong": "a my", "correction": "my", "options": ["my", "an my", "the my"], "hint": "Лишнее слово перед my.", "explanation": "This is my brother. Перед my артикль не нужен.", "grammar": ["a1.possessives"], "troubles": ["articles"] },
