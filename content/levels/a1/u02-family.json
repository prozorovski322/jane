{
  "id": "a1.u02",
  "level": "A1",
  "order": 2,
  "title": { "en": "Family and friends", "ru": "Семья и друзья" },
  "description": "Рассказываем о семье и друзьях: кто есть кто, сколько лет, чей это брат. Отрицание и вопросы с to be, слова my, his, her, 's и числа до 100.",
  "goals": [
    "Могу назвать членов семьи и рассказать, кто есть кто.",
    "Могу сказать, чей это родственник: my mother, his sister, Tom's brother.",
    "Могу задать вопрос с to be и ответить коротко: Is she a nurse? — Yes, she is.",
    "Могу сказать, что это не так: He is not a doctor.",
    "Могу назвать числа до 100 и сказать, сколько лет близким.",
    "Могу написать короткий текст о своей семье."
  ],
  "grammar": ["a1.be-questions", "a1.possessives", "a1.numbers-100"],
  "troubles": ["word-order", "pron-th"],
  "words": [
    { "id": "family", "en": "family", "ipa": "ˈfæməli", "pos": "noun", "ru": ["семья"], "example": { "en": "My family is big.", "ru": "Моя семья большая." }, "picture": { "emoji": "👨‍👩‍👧‍👦" }, "topics": ["family"] },
    { "id": "mother", "en": "mother", "ipa": "ˈmʌðɚ", "pos": "noun", "ru": ["мать", "мама"], "example": { "en": "My mother is a nurse.", "ru": "Моя мама — медсестра." }, "troubles": ["pron-th"], "topics": ["family"] },
    { "id": "father", "en": "father", "ipa": "ˈfɑːðɚ", "pos": "noun", "ru": ["отец", "папа"], "example": { "en": "My father is an engineer.", "ru": "Мой отец — инженер." }, "troubles": ["pron-th"], "topics": ["family"] },
    { "id": "mom", "en": "mom", "ipa": "mɑːm", "pos": "noun", "ru": ["мама"], "example": { "en": "Mom, this is Tom.", "ru": "Мам, это Том." }, "note": "Mom — разговорная форма mother, так американцы называют маму. В британском английском — mum.", "topics": ["family"] },
    { "id": "dad", "en": "dad", "ipa": "dæd", "pos": "noun", "ru": ["папа"], "example": { "en": "Dad is a driver.", "ru": "Папа — водитель." }, "note": "Dad — разговорная форма father.", "topics": ["family"] },
    { "id": "parents", "en": "parents", "ipa": "ˈperənts", "pos": "noun", "ru": ["родители"], "example": { "en": "My parents are from Kazan.", "ru": "Мои родители из Казани." }, "note": "Parents — только во множественном числе. Не путайте с relatives (родственники).", "troubles": ["false-friends"], "topics": ["family"] },
    { "id": "sister", "en": "sister", "ipa": "ˈsɪstɚ", "pos": "noun", "ru": ["сестра"], "example": { "en": "My sister is Anna.", "ru": "Мою сестру зовут Анна." }, "topics": ["family"] },
    { "id": "brother", "en": "brother", "ipa": "ˈbrʌðɚ", "pos": "noun", "ru": ["брат"], "example": { "en": "My brother is Max.", "ru": "Моего брата зовут Макс." }, "troubles": ["pron-th"], "topics": ["family"] },
    { "id": "son", "en": "son", "ipa": "sʌn", "pos": "noun", "ru": ["сын"], "example": { "en": "Tom is Olga's son.", "ru": "Том — сын Ольги." }, "note": "Слово son читается так же, как sun («солнце»): [sʌn].", "topics": ["family"] },
    { "id": "daughter", "en": "daughter", "ipa": "ˈdɔːtɚ", "pos": "noun", "ru": ["дочь"], "example": { "en": "Anna is Ivan's daughter.", "ru": "Анна — дочь Ивана." }, "note": "Буквы gh не читаются: [ˈdɔːtɚ].", "topics": ["family"] },
    { "id": "husband", "en": "husband", "ipa": "ˈhʌzbənd", "pos": "noun", "ru": ["муж"], "example": { "en": "Ivan is Olga's husband.", "ru": "Иван — муж Ольги." }, "topics": ["family"] },
    { "id": "wife", "en": "wife", "ipa": "waɪf", "pos": "noun", "ru": ["жена"], "example": { "en": "Olga is Ivan's wife.", "ru": "Ольга — жена Ивана." }, "forms": { "plural": "wives" }, "topics": ["family"] },
    { "id": "grandmother", "en": "grandmother", "ipa": "ˈɡrændˌmʌðɚ", "pos": "noun", "ru": ["бабушка"], "example": { "en": "My grandmother is seventy.", "ru": "Моей бабушке семьдесят." }, "picture": { "emoji": "👵" }, "troubles": ["pron-th"], "topics": ["family"] },
    { "id": "grandfather", "en": "grandfather", "ipa": "ˈɡrændˌfɑːðɚ", "pos": "noun", "ru": ["дедушка"], "example": { "en": "My grandfather is eighty.", "ru": "Моему дедушке восемьдесят." }, "picture": { "emoji": "👴" }, "troubles": ["pron-th"], "topics": ["family"] },
    { "id": "uncle", "en": "uncle", "ipa": "ˈʌŋkəl", "pos": "noun", "ru": ["дядя"], "example": { "en": "My uncle is a driver.", "ru": "Мой дядя — водитель." }, "topics": ["family"] },
    { "id": "aunt", "en": "aunt", "ipa": "ænt", "pos": "noun", "ru": ["тётя"], "example": { "en": "My aunt is a teacher.", "ru": "Моя тётя — учительница." }, "topics": ["family"] },
    { "id": "cousin", "en": "cousin", "ipa": "ˈkʌzən", "pos": "noun", "ru": ["двоюродный брат", "двоюродная сестра"], "example": { "en": "Sofia is my cousin.", "ru": "София — моя двоюродная сестра." }, "note": "Cousin подходит и для брата, и для сестры.", "topics": ["family"] },
    { "id": "child", "en": "child", "ipa": "tʃaɪld", "pos": "noun", "ru": ["ребёнок"], "example": { "en": "A child is small.", "ru": "Ребёнок маленький." }, "forms": { "plural": "children" }, "note": "Множественное число — children [ˈtʃɪldrən], а не childs.", "topics": ["family"] },
    { "id": "his", "en": "his", "ipa": "hɪz", "pos": "det", "ru": ["его"], "example": { "en": "This is Tom. His sister is Anna.", "ru": "Это Том. Его сестра — Анна." } },
    { "id": "her", "en": "her", "ipa": "hɝː", "pos": "det", "ru": ["её"], "example": { "en": "This is Anna. Her brother is Tom.", "ru": "Это Анна. Её брат — Том." } },
    { "id": "our", "en": "our", "ipa": "ˈaʊɚ", "pos": "det", "ru": ["наш"], "example": { "en": "Our family is big.", "ru": "Наша семья большая." } },
    { "id": "their", "en": "their", "ipa": "ðer", "pos": "det", "ru": ["их"], "example": { "en": "Their parents are from Italy.", "ru": "Их родители из Италии." }, "note": "Их — their, а не there: слова звучат одинаково, но значат разное.", "troubles": ["pron-th"] },
    { "id": "thirty", "en": "thirty", "ipa": "ˈθɝːti", "pos": "num", "ru": ["тридцать"], "example": { "en": "Marco is thirty.", "ru": "Марко тридцать." }, "troubles": ["pron-th"], "topics": ["numbers"] },
    { "id": "forty", "en": "forty", "ipa": "ˈfɔːrti", "pos": "num", "ru": ["сорок"], "example": { "en": "My uncle is forty.", "ru": "Моему дяде сорок." }, "topics": ["numbers"] },
    { "id": "fifty", "en": "fifty", "ipa": "ˈfɪfti", "pos": "num", "ru": ["пятьдесят"], "example": { "en": "My mother is fifty.", "ru": "Моей маме пятьдесят." }, "topics": ["numbers"] },
    { "id": "sixty", "en": "sixty", "ipa": "ˈsɪksti", "pos": "num", "ru": ["шестьдесят"], "example": { "en": "My aunt is sixty.", "ru": "Моей тёте шестьдесят." }, "topics": ["numbers"] },
    { "id": "seventy", "en": "seventy", "ipa": "ˈsevənti", "pos": "num", "ru": ["семьдесят"], "example": { "en": "My grandmother is seventy.", "ru": "Моей бабушке семьдесят." }, "topics": ["numbers"] },
    { "id": "eighty", "en": "eighty", "ipa": "ˈeɪti", "pos": "num", "ru": ["восемьдесят"], "example": { "en": "My grandfather is eighty.", "ru": "Моему дедушке восемьдесят." }, "topics": ["numbers"] },
    { "id": "ninety", "en": "ninety", "ipa": "ˈnaɪnti", "pos": "num", "ru": ["девяносто"], "example": { "en": "Her grandmother is ninety.", "ru": "Её бабушке девяносто." }, "topics": ["numbers"] },
    { "id": "hundred", "en": "hundred", "ipa": "ˈhʌndrəd", "pos": "num", "ru": ["сто"], "example": { "en": "One hundred.", "ru": "Сто." }, "note": "В английском перед hundred стоит one: one hundred (или a hundred).", "topics": ["numbers"] },
    { "id": "young", "en": "young", "ipa": "jʌŋ", "pos": "adj", "ru": ["молодой"], "example": { "en": "My sister is young.", "ru": "Моя сестра молодая." } },
    { "id": "married", "en": "married", "ipa": "ˈmerid", "pos": "adj", "ru": ["женатый", "замужняя"], "example": { "en": "Olga and Ivan are married.", "ru": "Ольга и Иван женаты." }, "note": "Married: о мужчине — «женат», о женщине — «замужем»: He is married, she is married." },
    { "id": "happy", "en": "happy", "ipa": "ˈhæpi", "pos": "adj", "ru": ["счастливый", "рад"], "example": { "en": "We are happy.", "ru": "Мы счастливы." } },
    { "id": "but", "en": "but", "ipa": "bʌt", "pos": "conj", "ru": ["но", "а"], "example": { "en": "I am not a doctor, but my sister is.", "ru": "Я не врач, а моя сестра врач." } },
    { "id": "also", "en": "also", "ipa": "ˈɔːlsoʊ", "pos": "adv", "ru": ["тоже", "также"], "example": { "en": "Tom is a teacher. Kate is also a teacher.", "ru": "Том учитель. Кейт тоже учитель." }, "note": "Also стоит после is: Kate is also a teacher. А too — в конце фразы." },
    { "id": "photo", "en": "photo", "ipa": "ˈfoʊtoʊ", "pos": "noun", "ru": ["фотография", "фото"], "example": { "en": "This is my family photo.", "ru": "Это фото моей семьи." } },
    { "id": "very", "en": "very", "ipa": "ˈveri", "pos": "adv", "ru": ["очень"], "example": { "en": "My sister is very nice.", "ru": "Моя сестра очень милая." }, "topics": ["adverbs"] },
    { "id": "really", "en": "really", "ipa": "ˈrɪli", "pos": "adv", "ru": ["правда", "действительно", "очень"], "example": { "en": "My friends are really nice.", "ru": "Мои друзья очень милые." }, "topics": ["adverbs"] },
    { "id": "all", "en": "all", "ipa": "ɔːl", "pos": "det", "ru": ["все", "весь"], "example": { "en": "All my friends are here.", "ru": "Все мои друзья здесь." }, "topics": ["grammar"] },
    { "id": "both", "en": "both", "ipa": "boʊθ", "pos": "det", "ru": ["оба", "и тот и другой"], "example": { "en": "Both my brothers are teachers.", "ru": "Оба моих брата — учителя." }, "topics": ["grammar"] },
    { "id": "other", "en": "other", "ipa": "ˈʌðɚ", "pos": "det", "ru": ["другой"], "example": { "en": "My other sister is a doctor.", "ru": "Моя другая сестра — врач." }, "topics": ["grammar"] },
    { "id": "another", "en": "another", "ipa": "əˈnʌðɚ", "pos": "det", "ru": ["ещё один", "другой"], "example": { "en": "This is another friend.", "ru": "Это ещё один друг." }, "topics": ["grammar"] },
    { "id": "same", "en": "same", "ipa": "seɪm", "pos": "adj", "ru": ["тот же самый", "одинаковый"], "example": { "en": "My sister and I are the same.", "ru": "Мы с сестрой одинаковые." }, "note": "Перед same всегда ставят the: the same village.", "topics": ["adjectives"] },
    { "id": "own", "en": "own", "ipa": "oʊn", "pos": "adj", "ru": ["собственный", "свой"], "example": { "en": "This is my own phone.", "ru": "Это мой собственный телефон." }, "note": "Own стоит после притяжательного слова: my own, her own.", "topics": ["adjectives"] }
  ],
  "texts": [
    {
      "id": "a1.u02.photos",
      "kind": "dialogue",
      "genre": "conversation",
      "title": { "en": "Family photo", "ru": "Семейное фото" },
      "speakers": [
        { "id": "anna", "name": "Anna", "voice": "female" },
        { "id": "tom", "name": "Tom", "voice": "male" }
      ],
      "lines": [
        { "speaker": "anna", "en": "Tom, who is this?", "ru": "Том, кто это?" },
        { "speaker": "tom", "en": "This is my family photo. This is my mother and this is my father.", "ru": "Это фото моей семьи. Это моя мама, а это мой папа." },
        { "speaker": "anna", "en": "How old is your mother?", "ru": "Сколько лет твоей маме?" },
        { "speaker": "tom", "en": "She is fifty. My father is fifty-two.", "ru": "Ей пятьдесят. Моему отцу пятьдесят два." },
        { "speaker": "anna", "en": "And who is this? Is she your sister?", "ru": "А это кто? Она твоя сестра?" },
        { "speaker": "tom", "en": "No, she isn't my sister. She is my cousin, Sofia.", "ru": "Нет, она не моя сестра. Это моя двоюродная сестра София." },
        { "speaker": "anna", "en": "Is Sofia married?", "ru": "София замужем?" },
        { "speaker": "tom", "en": "No, she is not. She is young.", "ru": "Нет. Она молодая." }
      ]
    },
    {
      "id": "a1.u02.max-family",
      "kind": "reading",
      "genre": "profile",
      "title": { "en": "My family", "ru": "Моя семья" },
      "lines": [
        { "en": "My name is Max. I am from Kazan. I am a designer. This is my family.", "ru": "Меня зовут Макс. Я из Казани. Я дизайнер. Это моя семья." },
        { "en": "My mother is Olga. She is a doctor. My father is Ivan. He is an engineer. They are fifty.", "ru": "Мою маму зовут Ольга. Она врач. Моего отца зовут Иван. Он инженер. Им по пятьдесят." },
        { "en": "My sister is Elena. She is twenty. She is a nurse, and her husband is a driver.", "ru": "Мою сестру зовут Елена. Ей двадцать. Она медсестра, а её муж водитель." },
        { "en": "My grandmother is eighty. She is not a teacher, but she is happy.", "ru": "Моей бабушке восемьдесят. Она не учитель, но она счастлива." }
      ]
    }
  ],
  "lessons": [
    {
      "id": "a1.u02.l01",
      "kind": "vocabulary",
      "title": "Моя семья",
      "exercises": [
        { "id": "a1.u02.l01.e01", "type": "picture_choice", "mode": "picture-to-word", "word": "family", "distractors": ["baby", "woman"], "hint": "Родители, дети — вся эта компания.", "explanation": "Family — «семья». Ударение на первый слог: FA-mi-ly." },
        { "id": "a1.u02.l01.e02", "type": "picture_choice", "mode": "word-to-picture", "word": "grandmother", "distractors": ["woman", "girl"], "hint": "Бабушка — пожилая женщина.", "explanation": "Grandmother — «бабушка»: grand («большая») + mother." },
        { "id": "a1.u02.l01.e03", "type": "picture_choice", "mode": "picture-to-word", "word": "grandfather", "distractors": ["man", "boy"], "hint": "Дедушка — пожилой мужчина.", "explanation": "Grandfather — «дедушка»: grand + father." },
        { "id": "a1.u02.l01.e04", "type": "translate_choice", "from": "en", "text": "mother", "options": ["мать, мама", "сестра", "бабушка"], "answer": 0, "hint": "Первые буквы похожи на русское «м».", "explanation": "Mother — «мать, мама». Буквы th читаются как звонкий [ð]: [ˈmʌðɚ]." },
        { "id": "a1.u02.l01.e05", "type": "translate_choice", "from": "ru", "text": "брат", "options": ["brother", "sister", "son"], "answer": 0, "hint": "Слово начинается с br.", "explanation": "Brother — «брат». Sister — «сестра», son — «сын»." },
        { "id": "a1.u02.l01.e06", "type": "match_pairs", "pairs": [{ "en": "mother", "ru": "мать" }, { "en": "father", "ru": "отец" }, { "en": "sister", "ru": "сестра" }, { "en": "brother", "ru": "брат" }, { "en": "parents", "ru": "родители" }], "hint": "Parents — это сразу двое.", "explanation": "Mother — «мать», father — «отец», sister — «сестра», brother — «брат», parents — «родители»." },
        { "id": "a1.u02.l01.e07", "type": "match_pairs", "pairs": [{ "en": "son", "ru": "сын" }, { "en": "daughter", "ru": "дочь" }, { "en": "husband", "ru": "муж" }, { "en": "wife", "ru": "жена" }, { "en": "cousin", "ru": "двоюродный брат" }], "hint": "Son и daughter — дети, husband и wife — супруги.", "explanation": "Son — «сын», daughter — «дочь», husband — «муж», wife — «жена», cousin — «двоюродный брат или сестра»." },
        { "id": "a1.u02.l01.e08", "type": "match_pairs", "pairs": [{ "en": "uncle", "ru": "дядя" }, { "en": "aunt", "ru": "тётя" }, { "en": "mom", "ru": "мама" }, { "en": "dad", "ru": "папа" }, { "en": "child", "ru": "ребёнок" }], "hint": "Mom и dad — короткие и разговорные.", "explanation": "Uncle — «дядя», aunt — «тётя», mom — «мама», dad — «папа», child — «ребёнок». Mom и dad говорят дома в семье." },
        { "id": "a1.u02.l01.e90", "type": "match_pairs", "pairs": [{ "en": "very", "ru": "очень" }, { "en": "really", "ru": "правда" }, { "en": "all", "ru": "все" }, { "en": "both", "ru": "оба" }, { "en": "other", "ru": "другой" }], "hint": "Новые слова.", "explanation": "Very — очень, really — правда, all — все, both — оба, other — другой." },
        { "id": "a1.u02.l01.e91", "type": "match_pairs", "pairs": [{ "en": "another", "ru": "ещё один" }, { "en": "same", "ru": "тот же самый" }, { "en": "own", "ru": "собственный" }], "hint": "Новые слова.", "explanation": "Another — ещё один, same — тот же самый, own — собственный." },
        { "id": "a1.u02.l01.e09", "type": "listen_choice", "audio": "brother", "question": "Какое слово вы слышите?", "options": ["brother", "mother", "father"], "answer": 0, "hint": "Слово начинается со звука [b].", "explanation": "Brother [ˈbrʌðɚ] начинается с [br]. Mother — с [m], father — с [f].", "troubles": ["pron-th"] },
        { "id": "a1.u02.l01.e10", "type": "listen_dictation", "text": "daughter", "hint": "Восемь букв, gh в середине не читаются.", "explanation": "Daughter — «дочь»: d-a-u-g-h-t-e-r. Читается [ˈdɔːtɚ]." },
        { "id": "a1.u02.l01.e11", "type": "type_translation", "from": "ru", "text": "сестра", "answers": ["sister"], "hint": "Шесть букв.", "explanation": "Sister — «сестра»: [ˈsɪstɚ]." },
        { "id": "a1.u02.l01.e12", "type": "fill_gap", "text": "My mother and father are my ___.", "translation": "Моя мама и мой папа — мои родители.", "answers": [["parents"]], "options": ["parents", "cousins", "children"], "hint": "Так называют маму и папу вместе.", "explanation": "Parents — «родители». Это слово всегда во множественном числе." },
        { "id": "a1.u02.l01.e13", "type": "tiles", "from": "ru", "text": "Это моя семья.", "answer": "This is my family.", "distractors": ["your", "are"], "hint": "Перед family стоит my.", "explanation": "This is my family — «это моя семья». Перед family нужен my, артикль не нужен." },
        { "id": "a1.u02.l01.e14", "type": "speak_repeat", "text": "This is my family.", "hint": "Ударение на FA-mi-ly.", "explanation": "В слове family первый слог ударный: [ˈfæməli]. Звук в начале — [æ]." }
      ]
    },
    {
      "id": "a1.u02.l02",
      "kind": "grammar",
      "title": "Не, ли и да: to be",
      "grammar": "a1.be-questions",
      "exercises": [
        { "id": "a1.u02.l02.e01", "type": "fill_gap", "text": "He is ___ a doctor.", "translation": "Он не врач.", "answers": [["not"]], "options": ["not", "no", "isn't"], "hint": "Нужно слово «не» после is.", "explanation": "He is not a doctor. Not стоит после is.", "grammar": ["a1.be-questions"] },
        { "id": "a1.u02.l02.e02", "type": "fill_gap", "text": "She ___ my sister.", "translation": "Она не моя сестра.", "answers": [["isn't", "is not"]], "options": ["isn't", "aren't", "am not"], "hint": "She — «она», значит is.", "explanation": "She isn't (is not) my sister. С she — isn't.", "grammar": ["a1.be-questions"] },
        { "id": "a1.u02.l02.e03", "type": "fill_gap", "text": "We ___ from Spain.", "translation": "Мы не из Испании.", "answers": [["aren't", "are not"]], "options": ["aren't", "isn't", "am not"], "hint": "We — «мы», значит are.", "explanation": "We aren't (are not) from Spain. С we — aren't.", "grammar": ["a1.be-questions"] },
