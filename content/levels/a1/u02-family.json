        { "id": "a1.u02.l02.e11", "type": "type_translation", "from": "ru", "text": "Она не студентка.", "answers": ["She is not a student.", "She isn't a student.", "She's not a student."], "difficulty": 2, "hint": "Нужны is, not и артикль.", "explanation": "She is not (isn't) a student. Перед профессией нужен артикль a.", "grammar": ["a1.be-questions"] },
