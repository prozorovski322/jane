        { "id": "a1.u02.l03.e13", "type": "word_stress", "word": "grandmother", "syllables": ["grand", "moth", "er"], "stress": 0, "hint": "Первый слог — grand.", "explanation": "GRAND-moth-er — ударение на первый слог.", "grammar": ["a1.possessives"] },
        { "id": "a1.u02.l03.e14", "type": "speak_repeat", "text": "My mother and my father.", "hint": "Th в mother и father — [ð], язык между зубами.", "explanation": "Mother [ˈmʌðɚ] и father [ˈfɑːðɚ]: звонкий [ð], не «з» и не «д».", "troubles": ["pron-th"] }
