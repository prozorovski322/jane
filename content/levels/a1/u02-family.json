        { "id": "a1.u02.l02.e05", "type": "fill_gap", "text": "___ she a nurse?", "translation": "Она медсестра?", "answers": [["Is"]], "options": ["Is", "Are", "Am"], "hint": "She — как «она».", "explanation": "Is she a nurse? С she — is.", "grammar": ["a1.be-questions"] },
        { "id": "a1.u02.l02.e06", "type": "error_correction", "text": "He no is a teacher.", "wrong": "no is", "correction": "is not", "options": ["is not", "not is", "am not"], "hint": "Not стоит после глагола.", "explanation": "He is not a teacher. Not стоит после is, а no здесь не нужно.", "grammar": ["a1.be-questions"], "troubles": ["word-order"] },
        { "id": "a1.u02.l02.e07", "type": "error_correction", "text": "Are she a nurse?", "wrong": "Are", "correction": "Is", "options": ["Is", "Am", "Be"], "hint": "She — не you и не we.", "explanation": "Is she a nurse? С she нужна форма is.", "grammar": ["a1.be-questions"] },
        { "id": "a1.u02.l02.e08", "type": "error_correction", "text": "Yes, she am.", "wrong": "am", "correction": "is", "options": ["is", "are", "be"], "hint": "В ответе повторяется глагол вопроса.", "explanation": "Yes, she is. Am бывает только с I.", "grammar": ["a1.be-questions"] },
        { "id": "a1.u02.l02.e09", "type": "tiles", "from": "ru", "text": "Твоя мама врач?", "answer": "Is your mother a doctor?", "distractors": ["are", "his"], "hint": "В вопросе is идёт первым.", "explanation": "Is your mother a doctor? Is стоит перед подлежащим your mother.", "grammar": ["a1.be-questions"], "troubles": ["word-order"] },
