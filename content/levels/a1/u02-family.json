        { "id": "a1.u02.l03.e08", "type": "error_correction", "text": "Tom is my cousin. Her name is Tom.", "wrong": "Her", "correction": "His", "options": ["His", "Our", "Their"], "hint": "Том — мужчина.", "explanation": "His name is Tom. Тому нужно his, а her — про женщин.", "grammar": ["a1.possessives"] },
        { "id": "a1.u02.l03.e09", "type": "tiles", "from": "ru", "text": "Это сестра Тома.", "answer": "This is Tom's sister.", "distractors": ["his", "are"], "hint": "Имя владельца с 's, потом сестра.", "explanation": "This is Tom's sister. Tom's — «Тома»: 's показывает, чья сестра.", "grammar": ["a1.possessives"] },
        { "id": "a1.u02.l03.e10", "type": "type_translation", "from": "ru", "text": "Это брат Анны.", "answers": ["This is Anna's brother."], "difficulty": 2, "hint": "Имя Anna и окончание 's.", "explanation": "This is Anna's brother. Слово Anna's — «Анны».", "grammar": ["a1.possessives"] },
        { "id": "a1.u02.l03.e11", "type": "type_translation", "from": "ru", "text": "Их мама медсестра.", "answers": ["Their mother is a nurse.", "Their mom is a nurse."], "difficulty": 2, "hint": "Their — «их».", "explanation": "Their mother is a nurse. Перед mother стоит their, артикль не нужен.", "grammar": ["a1.possessives"] },
