  "texts": [
    {
      "id": "a1.u10.invite",
      "kind": "dialogue",
      "genre": "conversation",
      "title": { "en": "Let's play tennis", "ru": "Давай сыграем в теннис" },
      "speakers": [
        { "id": "anna", "name": "Anna", "voice": "female" },
        { "id": "tom", "name": "Tom", "voice": "male" }
      ],
      "lines": [
        { "speaker": "anna", "en": "Tom, what do you do in your free time?", "ru": "Том, что ты делаешь в свободное время?" },
        { "speaker": "tom", "en": "I often play football. Sometimes I play the guitar.", "ru": "Я часто играю в футбол. Иногда играю на гитаре." },
        { "speaker": "anna", "en": "Great! Do you like tennis?", "ru": "Здорово! Ты любишь теннис?" },
        { "speaker": "tom", "en": "Yes, but I can't play tennis well.", "ru": "Да, но я не умею хорошо играть в теннис." },
        { "speaker": "anna", "en": "Let's play together on Saturday.", "ru": "Давай сыграем вместе в субботу." },
        { "speaker": "tom", "en": "Good idea! What time?", "ru": "Хорошая идея! Во сколько?" },
        { "speaker": "anna", "en": "At ten o'clock, in the park.", "ru": "В десять часов, в парке." },
        { "speaker": "tom", "en": "Sure! See you on Saturday.", "ru": "Конечно! Увидимся в субботу." }
      ]
    },
    {
      "id": "a1.u10.max-weekend",
      "kind": "reading",
      "genre": "article",
      "title": { "en": "Max's free time", "ru": "Свободное время Макса" },
      "lines": [
        { "en": "Max is a designer, but he always has free time on Saturday and Sunday. He never works at the weekend.", "ru": "Макс — дизайнер, но у него всегда есть свободное время в субботу и воскресенье. В выходные он никогда не работает." },
        { "en": "He often plays tennis in the park, and sometimes he plays chess with his friend. He can draw, and he can play the guitar well.", "ru": "Он часто играет в теннис в парке, а иногда играет в шахматы с другом. Он умеет рисовать и хорошо играет на гитаре." },
        { "en": "His sister can swim, but she can't play tennis. In the evening they usually watch a film together. On Friday it is his birthday, and there is a party.", "ru": "Его сестра умеет плавать, но не умеет играть в теннис. Вечером они обычно вместе смотрят фильм. В пятницу у него день рождения, и будет вечеринка." }
      ]
    }
  ],
