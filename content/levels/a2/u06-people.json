{
  "id": "a2.u06",
  "level": "A2",
  "order": 6,
  "title": { "en": "People and looks", "ru": "Люди и внешность" },
  "description": "Описываем людей: как они выглядят и какие у них характеры. He is tall, she has long hair, What does she look like?, порядок прилагательных.",
  "goals": [
    "Могу описать внешность: She is tall and slim. She has long dark hair.",
    "Могу описать характер: He is kind and quiet.",
    "Могу спросить: What does she look like? What is he like?",
    "Могу сказать, что человек выглядит усталым или счастливым: She looks tired.",
    "Могу расставить прилагательные по порядку: a beautiful young woman.",
    "Могу написать короткое описание человека."
  ],
  "grammar": ["a2.describing-people", "a2.look-like", "a2.adjective-order"],
  "troubles": ["word-order"],
  "words": [
    { "id": "tall", "en": "tall", "ipa": "tɔːl", "pos": "adj", "ru": ["высокий"], "example": { "en": "My brother is tall.", "ru": "Мой брат высокий." }, "topics": ["looks"] },
    { "id": "short", "en": "short", "ipa": "ʃɔːrt", "pos": "adj", "ru": ["низкий", "короткий"], "example": { "en": "She has short hair.", "ru": "У неё короткие волосы." }, "topics": ["looks"] },
    { "id": "slim", "en": "slim", "ipa": "slɪm", "pos": "adj", "ru": ["стройный"], "example": { "en": "My sister is tall and slim.", "ru": "Моя сестра высокая и стройная." }, "topics": ["looks"] },
    { "id": "hair", "en": "hair", "ipa": "her", "pos": "noun", "ru": ["волосы"], "example": { "en": "She has long dark hair.", "ru": "У неё длинные тёмные волосы." }, "note": "Hair — несчитаемое слово: her hair is long, а не her hairs are long.", "topics": ["looks"] },
    { "id": "eye", "en": "eye", "ipa": "aɪ", "pos": "noun", "ru": ["глаз"], "example": { "en": "He has brown eyes.", "ru": "У него карие глаза." }, "forms": { "plural": "eyes" }, "topics": ["looks"] },
    { "id": "face", "en": "face", "ipa": "feɪs", "pos": "noun", "ru": ["лицо"], "example": { "en": "She has a kind face.", "ru": "У неё доброе лицо." }, "topics": ["looks"] },
    { "id": "beard", "en": "beard", "ipa": "bɪrd", "pos": "noun", "ru": ["борода"], "example": { "en": "My uncle has a beard.", "ru": "У моего дяди борода." }, "topics": ["looks"] },
    { "id": "long", "en": "long", "ipa": "lɔːŋ", "pos": "adj", "ru": ["длинный"], "example": { "en": "She has long hair.", "ru": "У неё длинные волосы." }, "topics": ["looks"] },
    { "id": "blond", "en": "blond", "ipa": "blɑːnd", "pos": "adj", "ru": ["светловолосый"], "example": { "en": "He has blond hair.", "ru": "У него светлые волосы." }, "topics": ["looks"] },
    { "id": "dark", "en": "dark", "ipa": "dɑːrk", "pos": "adj", "ru": ["тёмный"], "example": { "en": "She has dark hair and brown eyes.", "ru": "У неё тёмные волосы и карие глаза." }, "topics": ["looks"] },
    { "id": "curly", "en": "curly", "ipa": "ˈkɝːli", "pos": "adj", "ru": ["кудрявый"], "example": { "en": "My sister has curly hair.", "ru": "У моей сестры кудрявые волосы." }, "topics": ["looks"] },
    { "id": "handsome", "en": "handsome", "ipa": "ˈhænsəm", "pos": "adj", "ru": ["красивый (о мужчине)"], "example": { "en": "He is a handsome young man.", "ru": "Он красивый молодой человек." }, "note": "Handsome говорят о мужчинах, о женщинах — pretty или beautiful.", "topics": ["looks"] },
    { "id": "pretty", "en": "pretty", "ipa": "ˈprɪti", "pos": "adj", "ru": ["симпатичная", "хорошенькая"], "example": { "en": "She is a pretty girl.", "ru": "Она симпатичная девушка." }, "topics": ["looks"] },
    { "id": "mouth", "en": "mouth", "ipa": "maʊθ", "pos": "noun", "ru": ["рот"], "example": { "en": "Open your mouth.", "ru": "Откройте рот." }, "troubles": ["pron-th"], "topics": ["body"] },
    { "id": "ear", "en": "ear", "ipa": "ɪr", "pos": "noun", "ru": ["ухо"], "example": { "en": "He has small ears.", "ru": "У него маленькие уши." }, "forms": { "plural": "ears" }, "topics": ["body"] },
    { "id": "hand", "en": "hand", "ipa": "hænd", "pos": "noun", "ru": ["рука (кисть)"], "example": { "en": "I have a book in my hand.", "ru": "У меня в руке книга." }, "topics": ["body"] },
    { "id": "head", "en": "head", "ipa": "hed", "pos": "noun", "ru": ["голова"], "example": { "en": "I have a hat on my head.", "ru": "На голове у меня шляпа." }, "topics": ["body"] },
    { "id": "arm", "en": "arm", "ipa": "ɑːrm", "pos": "noun", "ru": ["рука (от плеча)"], "example": { "en": "He broke his arm.", "ru": "Он сломал руку." }, "topics": ["body"] },
    { "id": "leg", "en": "leg", "ipa": "leɡ", "pos": "noun", "ru": ["нога"], "example": { "en": "She has long legs.", "ru": "У неё длинные ноги." }, "topics": ["body"] },
    { "id": "friendly", "en": "friendly", "ipa": "ˈfrendli", "pos": "adj", "ru": ["дружелюбный"], "example": { "en": "My neighbor is friendly.", "ru": "Мой сосед дружелюбный." }, "topics": ["character"] },
    { "id": "kind", "en": "kind", "ipa": "kaɪnd", "pos": "adj", "ru": ["добрый"], "example": { "en": "My grandmother is kind.", "ru": "Моя бабушка добрая." }, "topics": ["character"] },
    { "id": "shy", "en": "shy", "ipa": "ʃaɪ", "pos": "adj", "ru": ["застенчивый"], "example": { "en": "He is shy and quiet.", "ru": "Он застенчивый и тихий." }, "topics": ["character"] },
    { "id": "quiet", "en": "quiet", "ipa": "ˈkwaɪət", "pos": "adj", "ru": ["тихий"], "example": { "en": "My sister is quiet.", "ru": "Моя сестра тихая." }, "topics": ["character"] },
    { "id": "clever", "en": "clever", "ipa": "ˈklevɚ", "pos": "adj", "ru": ["умный"], "example": { "en": "Our teacher is clever.", "ru": "Наш учитель умный." }, "topics": ["character"] },
    { "id": "lazy", "en": "lazy", "ipa": "ˈleɪzi", "pos": "adj", "ru": ["ленивый"], "example": { "en": "My brother is lazy on Sunday.", "ru": "По воскресеньям мой брат ленивый." }, "topics": ["character"] },
    { "id": "polite", "en": "polite", "ipa": "pəˈlaɪt", "pos": "adj", "ru": ["вежливый"], "example": { "en": "The waiter is polite.", "ru": "Официант вежливый." }, "topics": ["character"] },
    { "id": "serious", "en": "serious", "ipa": "ˈsɪriəs", "pos": "adj", "ru": ["серьёзный"], "example": { "en": "My boss is serious.", "ru": "Мой босс серьёзный." }, "topics": ["character"] },
    { "id": "honest", "en": "honest", "ipa": "ˈɑːnɪst", "pos": "adj", "ru": ["честный"], "example": { "en": "He is an honest man.", "ru": "Он честный человек." }, "note": "Буква h в слове honest не читается.", "topics": ["character"] },
    { "id": "describe", "en": "describe", "ipa": "dɪˈskraɪb", "pos": "verb", "ru": ["описывать"], "example": { "en": "Describe your friend.", "ru": "Опишите вашего друга." }, "forms": { "third": "describes" }, "topics": ["verbs"] },
    { "id": "neighbor", "en": "neighbor", "ipa": "ˈneɪbɚ", "pos": "noun", "ru": ["сосед"], "example": { "en": "My neighbor is a nice woman.", "ru": "Моя соседка — приятная женщина." }, "note": "Британский вариант написания — neighbour.", "topics": ["people"] },
    { "id": "boss", "en": "boss", "ipa": "bɔːs", "pos": "noun", "ru": ["начальник"], "example": { "en": "My boss is serious.", "ru": "Мой начальник серьёзный." }, "topics": ["people"] },
    { "id": "twin", "en": "twin", "ipa": "twɪn", "pos": "noun", "ru": ["близнец"], "example": { "en": "I have a twin brother.", "ru": "У меня есть брат-близнец." }, "topics": ["people"] },
    { "id": "look-like", "en": "look like", "ipa": "lʊk laɪk", "pos": "phrase", "ru": ["быть похожим", "выглядеть как"], "example": { "en": "She looks like her mother.", "ru": "Она похожа на свою мать." }, "forms": { "third": "looks like" }, "topics": ["looks"] }
