  "texts": [
    {
      "id": "a2.u06.sister",
      "kind": "dialogue",
      "genre": "conversation",
      "title": { "en": "What does she look like?", "ru": "Как она выглядит?" },
      "speakers": [
        { "id": "tom", "name": "Tom", "voice": "male" },
        { "id": "anna", "name": "Anna", "voice": "female" }
      ],
      "lines": [
        { "speaker": "tom", "en": "Anna, I am going to meet your sister at the station. What does she look like?", "ru": "Анна, я собираюсь встретить твою сестру на вокзале. Как она выглядит?" },
        { "speaker": "anna", "en": "She is tall and slim. She has long dark hair and brown eyes.", "ru": "Она высокая и стройная. У неё длинные тёмные волосы и карие глаза." },
        { "speaker": "tom", "en": "How old is she?", "ru": "Сколько ей лет?" },
        { "speaker": "anna", "en": "She is twenty-five. She wears glasses.", "ru": "Ей двадцать пять. Она носит очки." },
        { "speaker": "tom", "en": "What is she like?", "ru": "А какая она по характеру?" },
        { "speaker": "anna", "en": "She is kind and quiet, but she is shy. She is clever and funny too.", "ru": "Она добрая и тихая, но застенчивая. Ещё она умная и смешная." },
        { "speaker": "tom", "en": "OK. I will find her.", "ru": "Хорошо. Я её найду." },
        { "speaker": "anna", "en": "She will smile at you. You will see.", "ru": "Она тебе улыбнётся. Сам увидишь." }
      ]
    },
    {
      "id": "a2.u06.twin",
      "kind": "reading",
      "genre": "article",
      "title": { "en": "My twin brother", "ru": "Мой брат-близнец" },
      "lines": [
        { "en": "I have a twin brother. His name is Ivan. He is my best friend and I love him. We are twins: we are tall, with short dark hair and brown eyes.", "ru": "У меня есть брат-близнец. Его зовут Иван. Он мой лучший друг, и я его люблю. Мы близнецы: мы высокие, у нас короткие тёмные волосы и карие глаза." },
        { "en": "But we are different. I am serious and quiet, and my boss says that I am honest and polite. Ivan is funny and friendly.", "ru": "Но мы разные. Я серьёзный и тихий, и мой начальник говорит, что я честный и вежливый. Иван смешной и дружелюбный." },
        { "en": "He is never shy and he talks to new people. On Sunday he is lazy and sleeps late, but I am always busy. Now Ivan has a beard, and I don't.", "ru": "Он никогда не стесняется и разговаривает с новыми людьми. В воскресенье он ленивый и долго спит, а я всегда занят. Теперь у Ивана борода, а у меня нет." }
      ]
    }
  ],
  "lessons": [
    {
      "id": "a2.u06.l01",
      "kind": "vocabulary",
      "title": "Внешность и части тела",
      "exercises": [
        { "id": "a2.u06.l01.e01", "type": "match_pairs", "pairs": [{ "en": "tall", "ru": "высокий" }, { "en": "short", "ru": "низкий" }, { "en": "slim", "ru": "стройный" }, { "en": "long", "ru": "длинный" }, { "en": "dark", "ru": "тёмный" }], "hint": "Tall и short — противоположные.", "explanation": "Tall — высокий, short — низкий, slim — стройный, long — длинный, dark — тёмный." },
        { "id": "a2.u06.l01.e02", "type": "match_pairs", "pairs": [{ "en": "blond", "ru": "светловолосый" }, { "en": "curly", "ru": "кудрявый" }, { "en": "handsome", "ru": "красивый" }, { "en": "pretty", "ru": "симпатичная" }, { "en": "beard", "ru": "борода" }], "hint": "Handsome — о мужчине.", "explanation": "Blond — светловолосый, curly — кудрявый, handsome — красивый, pretty — симпатичная, beard — борода." },
        { "id": "a2.u06.l01.e03", "type": "match_pairs", "pairs": [{ "en": "hair", "ru": "волосы" }, { "en": "eye", "ru": "глаз" }, { "en": "face", "ru": "лицо" }, { "en": "mouth", "ru": "рот" }, { "en": "ear", "ru": "ухо" }], "hint": "Части лица.", "explanation": "Hair — волосы, eye — глаз, face — лицо, mouth — рот, ear — ухо." },
        { "id": "a2.u06.l01.e04", "type": "match_pairs", "pairs": [{ "en": "hand", "ru": "рука" }, { "en": "head", "ru": "голова" }, { "en": "arm", "ru": "рука от плеча" }, { "en": "leg", "ru": "нога" }, { "en": "twin", "ru": "близнец" }], "hint": "Hand и arm — две руки.", "explanation": "Hand — кисть, head — голова, arm — рука, leg — нога, twin — близнец." },
        { "id": "a2.u06.l01.e05", "type": "translate_choice", "from": "ru", "text": "У неё длинные тёмные волосы.", "options": ["She has long dark hair.", "She is long dark hair.", "She have long dark hair."], "answer": 0, "hint": "Волосы — с have.", "explanation": "She has long dark hair. С she — has.", "grammar": ["a2.describing-people"] },
        { "id": "a2.u06.l01.e06", "type": "translate_choice", "from": "en", "text": "He has a beard.", "options": ["У него борода.", "Он бородатый человек.", "Он носит бороду."], "answer": 0, "hint": "Have — «иметь».", "explanation": "He has a beard — «у него борода»." },
        { "id": "a2.u06.l01.e07", "type": "fill_gap", "text": "My brother is ___ and slim.", "translation": "Мой брат высокий и стройный.", "answers": [["tall"]], "options": ["tall", "short", "long"], "hint": "Противоположное — short.", "explanation": "Правильно: My brother is tall and slim." },
        { "id": "a2.u06.l01.e08", "type": "fill_gap", "text": "She has ___ hair.", "translation": "У неё кудрявые волосы.", "answers": [["curly"]], "options": ["curly", "tall", "slim"], "hint": "Волосы, которые завиваются.", "explanation": "Правильно: She has curly hair." },
        { "id": "a2.u06.l01.e09", "type": "fill_gap", "text": "I have a ___ brother.", "translation": "У меня есть брат-близнец.", "answers": [["twin"]], "options": ["twin", "beard", "short"], "hint": "Родились вместе.", "explanation": "Правильно: I have a twin brother." },
        { "id": "a2.u06.l01.e10", "type": "listen_choice", "audio": "He has brown eyes and a beard.", "question": "Что вы слышите?", "options": ["He has brown eyes and a beard.", "He has blue eyes and a beard.", "He has brown eyes and short hair."], "answer": 0, "hint": "Цвет глаз — карий.", "explanation": "He has brown eyes and a beard — «у него карие глаза и борода».", "grammar": ["a2.describing-people"] },
        { "id": "a2.u06.l01.e11", "type": "listen_dictation", "text": "She has long dark hair.", "hint": "Пять слов.", "explanation": "She has long dark hair — «у неё длинные тёмные волосы»." },
        { "id": "a2.u06.l01.e12", "type": "type_translation", "from": "ru", "text": "лицо", "answers": ["face"], "hint": "Четыре буквы.", "explanation": "Face [feɪs] — «лицо»." },
        { "id": "a2.u06.l01.e13", "type": "minimal_pair", "pair": [{ "en": "hair", "ipa": "her" }, { "en": "here", "ipa": "hɪr" }], "say": 0, "hint": "В одном слове гласный как в слове «хэр».", "explanation": "Hair [her] — «волосы», here [hɪr] — «здесь».", "troubles": ["pron-vowels"] },
        { "id": "a2.u06.l01.e14", "type": "word_stress", "word": "handsome", "syllables": ["hand", "some"], "stress": 0, "hint": "Первый слог.", "explanation": "HAND-some — ударение на первый слог." }
      ]
    },
    {
      "id": "a2.u06.l02",
      "kind": "vocabulary",
      "title": "Характер",
      "exercises": [
        { "id": "a2.u06.l02.e01", "type": "match_pairs", "pairs": [{ "en": "friendly", "ru": "дружелюбный" }, { "en": "kind", "ru": "добрый" }, { "en": "shy", "ru": "застенчивый" }, { "en": "quiet", "ru": "тихий" }, { "en": "clever", "ru": "умный" }], "hint": "Слова про характер.", "explanation": "Friendly — дружелюбный, kind — добрый, shy — застенчивый, quiet — тихий, clever — умный." },
        { "id": "a2.u06.l02.e02", "type": "match_pairs", "pairs": [{ "en": "lazy", "ru": "ленивый" }, { "en": "polite", "ru": "вежливый" }, { "en": "serious", "ru": "серьёзный" }, { "en": "honest", "ru": "честный" }, { "en": "describe", "ru": "описывать" }], "hint": "Первые четыре — черты характера.", "explanation": "Lazy — ленивый, polite — вежливый, serious — серьёзный, honest — честный, describe — описывать." },
        { "id": "a2.u06.l02.e03", "type": "match_pairs", "pairs": [{ "en": "neighbor", "ru": "сосед" }, { "en": "boss", "ru": "начальник" }, { "en": "look like", "ru": "быть похожим" }, { "en": "funny", "ru": "смешной" }, { "en": "twin", "ru": "близнец" }], "hint": "Люди вокруг нас.", "explanation": "Neighbor — сосед, boss — начальник, look like — быть похожим, funny — смешной, twin — близнец." },
        { "id": "a2.u06.l02.e04", "type": "translate_choice", "from": "ru", "text": "вежливый", "options": ["polite", "lazy", "shy"], "answer": 0, "hint": "Говорит «пожалуйста» и «спасибо».", "explanation": "Polite [pəˈlaɪt] — «вежливый»." },
        { "id": "a2.u06.l02.e05", "type": "translate_choice", "from": "en", "text": "honest", "options": ["честный", "серьёзный", "смешной"], "answer": 0, "hint": "Не обманывает.", "explanation": "Honest [ˈɑːnɪst] — «честный». Буква h не читается." },
        { "id": "a2.u06.l02.e06", "type": "fill_gap", "text": "My boss is ___. He never laughs at work.", "translation": "Мой начальник серьёзный. Он никогда не смеётся на работе.", "answers": [["serious"]], "options": ["serious", "lazy", "funny"], "hint": "Не смеётся.", "explanation": "Правильно: My boss is serious." },
        { "id": "a2.u06.l02.e07", "type": "fill_gap", "text": "My brother is ___. He sleeps late.", "translation": "Мой брат ленивый. Он долго спит.", "answers": [["lazy"]], "options": ["lazy", "polite", "honest"], "hint": "Не любит работать.", "explanation": "Правильно: My brother is lazy." },
        { "id": "a2.u06.l02.e08", "type": "fill_gap", "text": "She is ___ and does not talk to new people.", "translation": "Она застенчивая и не разговаривает с новыми людьми.", "answers": [["shy"]], "options": ["shy", "friendly", "clever"], "hint": "Смущается.", "explanation": "Правильно: She is shy." },
        { "id": "a2.u06.l02.e09", "type": "fill_gap", "text": "My ___ is a friendly woman.", "translation": "Моя соседка — дружелюбная женщина.", "answers": [["neighbor"]], "options": ["neighbor", "boss", "twin"], "hint": "Живёт рядом.", "explanation": "Правильно: My neighbor is a friendly woman." },
        { "id": "a2.u06.l02.e10", "type": "listen_choice", "audio": "My boss is serious but polite.", "question": "Что вы слышите?", "options": ["My boss is serious but polite.", "My boss is funny and polite.", "My boss is lazy but honest."], "answer": 0, "hint": "Строгий начальник.", "explanation": "My boss is serious but polite — «мой начальник серьёзный, но вежливый»." },
        { "id": "a2.u06.l02.e11", "type": "listen_dictation", "text": "She is kind and quiet.", "hint": "Пять слов.", "explanation": "She is kind and quiet — «она добрая и тихая»." },
