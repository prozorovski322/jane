    {
      "id": "pa1.u05.what-color",
      "kind": "dialogue",
      "genre": "conversation",
      "title": { "en": "What is it?", "ru": "Что это?" },
      "speakers": [
        { "id": "anna", "name": "Anna", "voice": "female" },
        { "id": "tom", "name": "Tom", "voice": "male" }
      ],
      "lines": [
        { "speaker": "anna", "en": "What is it, Tom?", "ru": "Что это, Том?" },
        { "speaker": "tom", "en": "It is a bag.", "ru": "Это сумка." },
        { "speaker": "anna", "en": "What color is it?", "ru": "Какого она цвета?" },
        { "speaker": "tom", "en": "It is blue and white.", "ru": "Она синяя с белым." },
        { "speaker": "anna", "en": "Thank you, Tom!", "ru": "Спасибо, Том!" },
        { "speaker": "tom", "en": "Bye, Anna!", "ru": "Пока, Анна!" }
      ]
    },
    {
      "id": "pa1.u05.things",
      "kind": "reading",
      "genre": "article",
      "title": { "en": "Things in a room", "ru": "Вещи в комнате" },
      "lines": [
        { "en": "A brown desk. A black computer. A small phone. A red pencil.", "ru": "Коричневый письменный стол. Чёрный компьютер. Маленький телефон. Красный карандаш." },
        { "en": "A big white house. A green door. A pink flower. A grey bird.", "ru": "Большой белый дом. Зелёная дверь. Розовый цветок. Серая птица." }
      ]
    }
  ],
