        { "id": "pa1.u05.l03.e07", "type": "tiles", "from": "ru", "text": "Большой белый дом.", "answer": "A big white house.", "distractors": ["small", "grey"], "difficulty": 2, "hint": "Сначала размер.", "explanation": "A big white house — «большой белый дом».", "grammar": ["pa1.adjectives"] },
