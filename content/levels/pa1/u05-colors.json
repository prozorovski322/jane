      "exercises": [
        { "id": "pa1.u05.l01.e01", "type": "picture_choice", "mode": "picture-to-word", "word": "blue", "distractors": ["green", "red"], "hint": "Цвет неба в ясный день.", "explanation": "Blue — «синий». Ue на конце читается как долгое «у:»: [bluː]." },
        { "id": "pa1.u05.l01.e02", "type": "picture_choice", "mode": "word-to-picture", "word": "black", "distractors": ["white", "brown"], "hint": "Цвет ночи.", "explanation": "Black — «чёрный». Ck на конце читается как «к»." },
        { "id": "pa1.u05.l01.e03", "type": "picture_choice", "mode": "picture-to-word", "word": "green", "distractors": ["blue", "yellow"], "hint": "Цвет травы.", "explanation": "Green — «зелёный». Ee читается как долгое «и:»." },
        { "id": "pa1.u05.l01.e04", "type": "translate_choice", "from": "en", "text": "white", "options": ["белый", "серый", "чёрный"], "answer": 0, "hint": "Цвет снега.", "explanation": "White — «белый». Начало слова — [w], как короткое «у»." },
        { "id": "pa1.u05.l01.e05", "type": "translate_choice", "from": "ru", "text": "коричневый", "options": ["brown", "black", "blue"], "answer": 0, "hint": "Слово начинается с br.", "explanation": "Brown — «коричневый»: [braʊn]. Black — «чёрный», blue — «синий»." },
        { "id": "pa1.u05.l01.e06", "type": "match_pairs", "pairs": [{ "en": "red", "ru": "красный" }, { "en": "yellow", "ru": "жёлтый" }, { "en": "pink", "ru": "розовый" }, { "en": "grey", "ru": "серый" }, { "en": "orange", "ru": "оранжевый" }], "hint": "Red и yellow вы уже знаете.", "explanation": "Red — «красный», yellow — «жёлтый», pink — «розовый», grey — «серый», orange — «оранжевый» и «апельсин»." },
        { "id": "pa1.u05.l01.e07", "type": "listen_choice", "audio": "pink", "question": "Какое слово вы слышите?", "options": ["pink", "pen", "black"], "answer": 0, "hint": "В конце слышно «нк».", "explanation": "Pink — «розовый»: [pɪŋk]. Буквы nk читаются как «нк» в нос." },
        { "id": "pa1.u05.l01.e08", "type": "listen_choice", "audio": "grey", "question": "Какое слово вы слышите?", "options": ["grey", "green", "pink"], "answer": 0, "hint": "Слово заканчивается на «эй».", "explanation": "Grey — «серый»: [ɡreɪ]. Green — «зелёный»: [ɡriːn]." },
        { "id": "pa1.u05.l01.e09", "type": "fill_gap", "text": "What ___ is it?", "translation": "Какого это цвета?", "answers": [["color"]], "options": ["color", "name", "number"], "hint": "О цвете спрашивают этим словом.", "explanation": "What color is it? — «Какого это цвета?». Color — «цвет».", "grammar": ["pa1.adjectives"] },
        { "id": "pa1.u05.l01.e10", "type": "fill_gap", "text": "It is ___.", "translation": "Он белый.", "answers": [["white"]], "options": ["white", "black", "red"], "hint": "Цвет снега.", "explanation": "It is white — «он белый». Цвет называют после it is.", "grammar": ["pa1.adjectives"] },
        { "id": "pa1.u05.l01.e11", "type": "tiles", "from": "ru", "text": "Синяя сумка.", "answer": "A blue bag.", "distractors": ["red", "black"], "hint": "Сначала a, потом цвет, потом предмет.", "explanation": "A blue bag — «синяя сумка». Цвет стоит перед предметом.", "grammar": ["pa1.adjectives"] },
        { "id": "pa1.u05.l01.e12", "type": "type_translation", "from": "ru", "text": "Чёрная машина.", "answers": ["A black car."], "hint": "Три слова.", "explanation": "A black car — «чёрная машина».", "grammar": ["pa1.adjectives"] },
        { "id": "pa1.u05.l01.e13", "type": "speak_repeat", "text": "Red, blue, green, yellow.", "hint": "Четыре цвета подряд.", "explanation": "Произношение: red [red], blue [bluː], green [ɡriːn], yellow [ˈjeloʊ]." }
      ]
    },
