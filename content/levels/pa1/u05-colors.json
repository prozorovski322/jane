        { "id": "pa1.u05.l02.e07", "type": "translate_choice", "from": "en", "text": "computer", "options": ["компьютер", "телефон", "стол"], "answer": 0, "hint": "Слово похоже на русское.", "explanation": "Computer — «компьютер». Ударение на втором слоге: com-PU-ter." },
        { "id": "pa1.u05.l02.e08", "type": "translate_choice", "from": "ru", "text": "письменный стол", "options": ["desk", "door", "duck"], "answer": 0, "hint": "Слово начинается с d и заканчивается на k.", "explanation": "Desk — «письменный стол, парта». Table — другой стол, обеденный." },
        { "id": "pa1.u05.l02.e09", "type": "listen_choice", "audio": "cow", "question": "Какое слово вы слышите?", "options": ["cow", "car", "cup"], "answer": 0, "hint": "Слышно «кау».", "explanation": "Cow — «корова»: [kaʊ]. Car — «машина», cup — «чашка»." },
        { "id": "pa1.u05.l02.e10", "type": "listen_dictation", "text": "bird", "hint": "Четыре буквы.", "explanation": "Bird — «птица»: [bɝːd]. Ir читается как долгое «ё:»." },
        { "id": "pa1.u05.l02.e11", "type": "type_translation", "from": "ru", "text": "дверь", "answers": ["door"], "hint": "Четыре буквы, две из них — o.", "explanation": "Door — «дверь»: [dɔːr]." },
        { "id": "pa1.u05.l02.e12", "type": "tiles", "from": "ru", "text": "Это кошка.", "answer": "It is a cat.", "distractors": ["am", "dog"], "hint": "Для предмета и животного — it.", "explanation": "It is a cat — «это кошка». Для животных и вещей используется it.", "grammar": ["pa1.adjectives"] },
        { "id": "pa1.u05.l02.e13", "type": "fill_gap", "text": "What is it? — It is a ___.", "translation": "Что это? — Это лошадь.", "answers": [["horse"]], "options": ["horse", "blue", "small"], "hint": "Нужно название животного, не цвет и не размер.", "explanation": "It is a horse. После a стоит предмет или животное.", "grammar": ["pa1.adjectives"] },
        { "id": "pa1.u05.l02.e14", "type": "speak_repeat", "text": "What is it? It is a bird.", "hint": "Вопрос идёт вниз, ответ ровно.", "explanation": "What is it? — голос идёт вниз. It is a bird — ударение на bird." }
      ]
    },
