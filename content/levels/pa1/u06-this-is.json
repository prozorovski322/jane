          "hint": "В каждой фразе — кто это.",
          "explanation": "В тексте пять людей: мужчина, женщина, мальчик, девочка и малыш.",
          "questions": [
            { "kind": "mcq", "question": "Кто маленький?", "options": ["a baby", "a man", "a woman"], "answer": 0, "explanation": "В тексте: A baby is small." },
            { "kind": "tfn", "statement": "This is a girl.", "answer": "true", "explanation": "В тексте: This is a girl." },
            { "kind": "tfn", "statement": "A baby is big.", "answer": "false", "explanation": "В тексте: A baby is not big." },
