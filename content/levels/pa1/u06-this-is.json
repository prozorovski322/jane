        { "id": "pa1.u06.l03.e03", "type": "listen_dictation", "text": "No, it is not.", "answers": ["No, it's not.", "No, it isn't."], "hint": "Четыре слова.", "explanation": "No, it is not — «нет, не он (не это)». Короткий отрицательный ответ.", "grammar": ["pa1.this-is"] },
