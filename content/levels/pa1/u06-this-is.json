{
  "id": "pa1.u06",
  "level": "PA1",
  "order": 6,
  "title": { "en": "I am… This is…", "ru": "Я… Это…" },
  "description": "Называем людей и предметы: This is a boy. Отрицаем: It is not red. Спрашиваем: Is it a bag? Who is this? Всё, что нужно, чтобы начать уровень A1.",
  "goals": [
    "Могу показать на человека или предмет и сказать: This is…",
    "Могу назвать людей: a boy, a girl, a man, a woman, a baby.",
    "Могу сказать «не»: It is not red. I am not ten.",
    "Могу задать вопрос Is it…? Are you…? Who is this? и ответить Yes, it is. No, it is not.",
    "Могу написать о себе несколько предложений: имя, возраст, что рядом."
  ],
  "grammar": ["pa1.this-is"],
  "troubles": ["word-order", "pron-th"],
  "words": [
    { "id": "this", "en": "this", "ipa": "ðɪs", "pos": "pron", "ru": ["это", "этот"], "example": { "en": "This is a book.", "ru": "Это книга." }, "troubles": ["pron-th"] },
    { "id": "not", "en": "not", "ipa": "nɑːt", "pos": "adv", "ru": ["не"], "example": { "en": "It is not red.", "ru": "Он не красный." }, "note": "Not стоит после am, is, are: I am not, it is not." },
    { "id": "who", "en": "who", "ipa": "huː", "pos": "pron", "ru": ["кто"], "example": { "en": "Who is it?", "ru": "Кто это?" } },
    { "id": "boy", "en": "boy", "ipa": "bɔɪ", "pos": "noun", "ru": ["мальчик"], "example": { "en": "A small boy.", "ru": "Маленький мальчик." }, "picture": { "emoji": "👦" }, "topics": ["people"] },
    { "id": "girl", "en": "girl", "ipa": "ɡɝːl", "pos": "noun", "ru": ["девочка"], "example": { "en": "A small girl.", "ru": "Маленькая девочка." }, "picture": { "emoji": "👧" }, "topics": ["people"] },
    { "id": "man", "en": "man", "ipa": "mæn", "pos": "noun", "ru": ["мужчина"], "example": { "en": "A big man.", "ru": "Большой мужчина." }, "forms": { "plural": "men" }, "note": "Множественное число — men [men].", "picture": { "emoji": "👨" }, "topics": ["people"] },
    { "id": "woman", "en": "woman", "ipa": "ˈwʊmən", "pos": "noun", "ru": ["женщина"], "example": { "en": "A man and a woman.", "ru": "Мужчина и женщина." }, "forms": { "plural": "women" }, "note": "Woman читается [ˈwʊmən]: первая гласная как в book. Множественное число — women [ˈwɪmɪn].", "picture": { "emoji": "👩" }, "topics": ["people"] },
    { "id": "baby", "en": "baby", "ipa": "ˈbeɪbi", "pos": "noun", "ru": ["младенец", "малыш"], "example": { "en": "A small baby.", "ru": "Маленький малыш." }, "picture": { "emoji": "👶" }, "topics": ["people"] }
  ],
  "texts": [
    {
      "id": "pa1.u06.who",
      "kind": "dialogue",
      "genre": "conversation",
      "title": { "en": "Who is this?", "ru": "Кто это?" },
      "speakers": [
        { "id": "anna", "name": "Anna", "voice": "female" },
        { "id": "tom", "name": "Tom", "voice": "male" }
      ],
      "lines": [
        { "speaker": "anna", "en": "Who is this, Tom?", "ru": "Кто это, Том?" },
        { "speaker": "tom", "en": "This is Max. Max is a boy.", "ru": "Это Макс. Макс — мальчик." },
        { "speaker": "anna", "en": "How old is Max?", "ru": "Сколько лет Максу?" },
        { "speaker": "tom", "en": "Max is twelve.", "ru": "Максу двенадцать." },
        { "speaker": "anna", "en": "And this? Is it a girl?", "ru": "А это? Это девочка?" },
        { "speaker": "tom", "en": "No, it is not a girl. It is a baby!", "ru": "Нет, это не девочка. Это малыш!" },
        { "speaker": "anna", "en": "Hello, baby!", "ru": "Здравствуй, малыш!" }
      ]
    },
    {
      "id": "pa1.u06.people",
      "kind": "reading",
      "genre": "article",
      "title": { "en": "People", "ru": "Люди" },
      "lines": [
        { "en": "This is a man. This is a woman.", "ru": "Это мужчина. Это женщина." },
        { "en": "This is a boy. This is a girl.", "ru": "Это мальчик. Это девочка." },
        { "en": "This is a baby. A baby is small. A baby is not big.", "ru": "Это малыш. Малыш маленький. Малыш не большой." }
      ]
    }
  ],
  "lessons": [
    {
      "id": "pa1.u06.l01",
      "kind": "vocabulary",
      "title": "Мальчик, девочка, мужчина, женщина",
      "exercises": [
        { "id": "pa1.u06.l01.e01", "type": "picture_choice", "mode": "picture-to-word", "word": "boy", "distractors": ["girl", "man"], "hint": "Это ребёнок мужского пола.", "explanation": "Boy — «мальчик». Oy читается как «ой»: [bɔɪ]." },
        { "id": "pa1.u06.l01.e02", "type": "picture_choice", "mode": "word-to-picture", "word": "woman", "distractors": ["girl", "baby"], "hint": "Это взрослая женщина.", "explanation": "Woman — «женщина»: [ˈwʊmən]. Girl — «девочка»." },
        { "id": "pa1.u06.l01.e03", "type": "picture_choice", "mode": "picture-to-word", "word": "baby", "distractors": ["boy", "girl"], "hint": "Самый маленький человек.", "explanation": "Baby — «малыш, младенец». Ударение на первый слог: BA-by." },
        { "id": "pa1.u06.l01.e04", "type": "translate_choice", "from": "en", "text": "girl", "options": ["девочка", "мальчик", "женщина"], "answer": 0, "hint": "Первая буква — g.", "explanation": "Girl — «девочка»: [ɡɝːl]. Boy — «мальчик»." },
        { "id": "pa1.u06.l01.e05", "type": "translate_choice", "from": "ru", "text": "мужчина", "options": ["man", "baby", "boy"], "answer": 0, "hint": "Три буквы.", "explanation": "Man — «мужчина»: [mæn]. Boy — «мальчик»." },
        { "id": "pa1.u06.l01.e06", "type": "match_pairs", "pairs": [{ "en": "boy", "ru": "мальчик" }, { "en": "girl", "ru": "девочка" }, { "en": "man", "ru": "мужчина" }, { "en": "woman", "ru": "женщина" }, { "en": "baby", "ru": "малыш" }], "hint": "Boy и girl — дети, man и woman — взрослые.", "explanation": "Boy — «мальчик», girl — «девочка», man — «мужчина», woman — «женщина», baby — «малыш»." },
        { "id": "pa1.u06.l01.e07", "type": "listen_choice", "audio": "woman", "question": "Какое слово вы слышите?", "options": ["woman", "man", "baby"], "answer": 0, "hint": "Слово длиннее, чем man.", "explanation": "Woman [ˈwʊmən] — «женщина». В man [mæn] гласная другая." },
        { "id": "pa1.u06.l01.e08", "type": "listen_dictation", "text": "girl", "hint": "Четыре буквы.", "explanation": "Girl — «девочка»: g-i-r-l. Ir читается как долгое «ё:»." },
        { "id": "pa1.u06.l01.e09", "type": "type_translation", "from": "ru", "text": "малыш", "answers": ["baby"], "hint": "Четыре буквы, начинается с b.", "explanation": "Baby — «малыш, младенец»." },
        { "id": "pa1.u06.l01.e10", "type": "tiles", "from": "ru", "text": "Мужчина и женщина.", "answer": "A man and a woman.", "distractors": ["boy", "girl"], "hint": "Перед каждым словом a.", "explanation": "A man and a woman — «мужчина и женщина». Перед каждым словом стоит a." },
        { "id": "pa1.u06.l01.e11", "type": "fill_gap", "text": "A ___ and a girl.", "translation": "Мальчик и девочка.", "answers": [["boy"]], "options": ["boy", "man", "baby"], "hint": "Девочка — girl, а мальчик?", "explanation": "A boy and a girl — «мальчик и девочка».", "grammar": ["pa1.this-is"] },
        { "id": "pa1.u06.l01.e12", "type": "minimal_pair", "pair": [{ "en": "man", "ipa": "mæn" }, { "en": "men", "ipa": "men" }], "say": 1, "hint": "Слово men — это «мужчины».", "explanation": "Man [mæn] — «мужчина», men [men] — «мужчины». Гласные различаются: [æ] и [e].", "troubles": ["pron-vowels"] },
        { "id": "pa1.u06.l01.e13", "type": "speak_repeat", "text": "A man and a woman.", "hint": "Слово and звучит коротко: ənd.", "explanation": "В быстрой речи and звучит коротко и неясно: a man ən a woman." }
      ]
    },
    {
      "id": "pa1.u06.l02",
      "kind": "grammar",
      "title": "This is… Is it…? It is not…",
      "grammar": "pa1.this-is",
      "exercises": [
        { "id": "pa1.u06.l02.e01", "type": "fill_gap", "text": "___ is a boy.", "translation": "Это мальчик.", "answers": [["This"]], "options": ["This", "Who", "Not"], "hint": "Так показывают на человека.", "explanation": "This is a boy — «это мальчик». This — «это, этот».", "grammar": ["pa1.this-is"], "troubles": ["pron-th"] },
        { "id": "pa1.u06.l02.e02", "type": "fill_gap", "text": "It is ___ red.", "translation": "Он не красный.", "answers": [["not"]], "options": ["not", "no", "yes"], "hint": "Нужно слово для «не».", "explanation": "It is not red — «он не красный». Not стоит после is.", "grammar": ["pa1.this-is"] },
        { "id": "pa1.u06.l02.e03", "type": "fill_gap", "text": "I am ___ ten.", "translation": "Мне не десять.", "answers": [["not"]], "options": ["not", "no", "is"], "hint": "Не — после am.", "explanation": "I am not ten — «мне не десять». Not стоит после am.", "grammar": ["pa1.this-is"] },
        { "id": "pa1.u06.l02.e04", "type": "fill_gap", "text": "___ is this?", "translation": "Кто это?", "answers": [["Who"]], "options": ["Who", "What color", "How old"], "hint": "Спрашиваем о человеке.", "explanation": "Who is this? — «Кто это?». Who — «кто».", "grammar": ["pa1.this-is"] },
        { "id": "pa1.u06.l02.e05", "type": "error_correction", "text": "This a girl.", "wrong": "This", "correction": "This is", "options": ["This is", "This am", "This are"], "hint": "В предложении не хватает глагола.", "explanation": "This is a girl — глагол is обязателен.", "grammar": ["pa1.this-is"], "troubles": ["word-order"] },
        { "id": "pa1.u06.l02.e06", "type": "error_correction", "text": "It not is a cat.", "wrong": "not is", "correction": "is not", "options": ["is not", "not am", "no is"], "hint": "Not стоит после is.", "explanation": "It is not a cat. Not стоит после is.", "grammar": ["pa1.this-is"], "troubles": ["word-order"] },
        { "id": "pa1.u06.l02.e07", "type": "error_correction", "text": "It is a bag?", "wrong": "It is", "correction": "Is it", "options": ["Is it", "It am", "Are it"], "hint": "В вопросе глагол идёт первым.", "explanation": "Is it a bag? В вопросе is стоит перед it.", "grammar": ["pa1.this-is"], "troubles": ["word-order"] },
        { "id": "pa1.u06.l02.e08", "type": "tiles", "from": "ru", "text": "Это не кошка.", "answer": "It is not a cat.", "distractors": ["am", "no"], "hint": "Not стоит после is.", "explanation": "It is not a cat — «это не кошка».", "grammar": ["pa1.this-is"] },
        { "id": "pa1.u06.l02.e09", "type": "tiles", "from": "ru", "text": "Это сумка?", "answer": "Is it a bag?", "distractors": ["am", "this"], "hint": "В вопросе is идёт первым.", "explanation": "Is it a bag? — «это сумка?».", "grammar": ["pa1.this-is"] },
        { "id": "pa1.u06.l02.e10", "type": "tiles", "from": "ru", "text": "Кто это?", "answer": "Who is this?", "distractors": ["what", "am"], "hint": "Who — «кто».", "explanation": "Who is this? — «Кто это?».", "grammar": ["pa1.this-is"] },
        { "id": "pa1.u06.l02.e11", "type": "translate_choice", "from": "en", "text": "Are you Tom? — Yes, I am.", "options": ["Ты Том? — Да.", "Ты Том? — Нет.", "Это Том? — Да."], "answer": 0, "hint": "Yes — да.", "explanation": "Are you Tom? — «Ты Том?». Yes, I am — «Да, я Том»." },
        { "id": "pa1.u06.l02.e12", "type": "type_translation", "from": "ru", "text": "Нет, это не сумка.", "answers": ["No, it is not a bag.", "No, it's not a bag.", "No, it isn't a bag."], "difficulty": 2, "hint": "Начните с No.", "explanation": "No, it is not a bag. После No — запятая, потом it is not.", "grammar": ["pa1.this-is"] },
        { "id": "pa1.u06.l02.e13", "type": "type_translation", "from": "ru", "text": "Ты Анна?", "answers": ["Are you Anna?"], "difficulty": 2, "hint": "С you — are, и в вопросе он идёт первым.", "explanation": "Are you Anna? В вопросе are стоит перед you.", "grammar": ["pa1.this-is", "pa1.i-am"], "troubles": ["word-order"] }
      ]
    },
