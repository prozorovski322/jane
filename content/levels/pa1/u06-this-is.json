        { "id": "pa1.u06.l03.e05", "type": "fill_gap", "text": "Is it a girl? — No, it is ___.", "translation": "Это девочка? — Нет, это не она.", "answers": [["not"]], "options": ["not", "no", "yes"], "hint": "После is — not.", "explanation": "No, it is not. Полный короткий отрицательный ответ.", "grammar": ["pa1.this-is"] },
        { "id": "pa1.u06.l03.e06", "type": "fill_gap", "text": "Are you Tom? — Yes, I ___.", "translation": "Ты Том? — Да.", "answers": [["am"]], "options": ["am", "are", "is"], "hint": "О себе — I am.", "explanation": "Yes, I am — «да, это я». Повторяется глагол из вопроса: am.", "grammar": ["pa1.this-is", "pa1.i-am"] },
        { "id": "pa1.u06.l03.e07", "type": "minimal_pair", "pair": [{ "en": "this", "ipa": "ðɪs" }, { "en": "miss", "ipa": "mɪs" }], "say": 0, "hint": "В слове this язык между зубами.", "explanation": "[ð] в this — звонкий звук, язык между зубами. Замена на «з» или «д» — типичная ошибка.", "troubles": ["pron-th"] },
        { "id": "pa1.u06.l03.e08", "type": "speak_repeat", "text": "This is a boy. This is a girl.", "hint": "Следите за th в this.", "explanation": "This [ðɪs]: кончик языка между зубами, голос включён.", "troubles": ["pron-th"] },
        { "id": "pa1.u06.l03.e09", "type": "speak_answer", "question": "Who are you?", "questionRu": "Кто вы? Ответьте о себе: I am a man или I am a woman.", "keywords": [["\\bI'?m\\b", "\\bI am\\b"], ["\\b(man|woman|boy|girl)\\b"]], "minKeywords": 2, "samples": ["I am a woman.", "I am a man."], "difficulty": 3, "hint": "I am a… и слово из урока.", "explanation": "Ответ: I am a man или I am a woman. Артикль a обязателен.", "grammar": ["pa1.this-is"] },
        { "id": "pa1.u06.l03.e10", "type": "speak_answer", "question": "What is your name?", "questionRu": "Как вас зовут? Ответьте полным предложением.", "keywords": [["\\bmy name('s| is)\\b", "\\bI'?m\\b", "\\bI am\\b"]], "minKeywords": 1, "samples": ["My name is Olga.", "I am Max."], "difficulty": 3, "hint": "My name is… или I am…", "explanation": "Повторяем знакомый вопрос: My name is… или I am…", "grammar": ["pa1.i-am"] }
      ]
    },
    {
      "id": "pa1.u06.l04",
      "kind": "reading",
      "title": "Люди",
