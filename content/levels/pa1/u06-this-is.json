        { "id": "pa1.u06.l04.e02", "type": "translate_choice", "from": "en", "text": "A baby is not big.", "options": ["Малыш не большой.", "Малыш большой.", "Мальчик не большой."], "answer": 0, "hint": "Not — «не».", "explanation": "A baby is not big — «малыш не большой»." },
        { "id": "pa1.u06.l04.e03", "type": "type_translation", "from": "ru", "text": "Это мужчина.", "answers": ["This is a man.", "It is a man."], "hint": "Три слова: this, is, a и man.", "explanation": "This is a man — «это мужчина».", "grammar": ["pa1.this-is"] },
        { "id": "pa1.u06.l04.e04", "type": "type_translation", "from": "ru", "text": "Малыш не большой.", "answers": ["A baby is not big."], "difficulty": 2, "hint": "Big — большой.", "explanation": "A baby is not big. Not стоит после is.", "grammar": ["pa1.this-is"] },
        { "id": "pa1.u06.l04.e05", "type": "tiles", "from": "ru", "text": "Это женщина.", "answer": "This is a woman.", "distractors": ["am", "who"], "hint": "Начните с фразы This is a…", "explanation": "This is a woman — «это женщина».", "grammar": ["pa1.this-is"] },
        { "id": "pa1.u06.l04.e08", "type": "fill_gap", "text": "A baby is ___ big.", "translation": "Малыш не большой.", "answers": [["not"]], "options": ["not", "no", "who"], "hint": "Нужно слово «не».", "explanation": "A baby is not big — «малыш не большой». Not стоит после is.", "grammar": ["pa1.this-is"] },
        { "id": "pa1.u06.l04.e06", "type": "speak_repeat", "text": "A baby is small. A baby is not big.", "hint": "Две фразы с паузой.", "explanation": "Small [smɔːl] и big [bɪɡ]: гласные разные, не путайте." },
        {
