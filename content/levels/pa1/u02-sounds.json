        { "id": "pa1.u02.l02.e02", "type": "listen_choice", "audio": "cake", "question": "Какое слово вы слышите?", "options": ["cake", "cup", "cat"], "answer": 0, "hint": "В слове слышно «эй».", "explanation": "Cake [keɪk] — с немой e. Cat [kæt] и cup [kʌp] — с короткими гласными.", "grammar": ["pa1.sounds"], "troubles": ["pron-vowels"] },
