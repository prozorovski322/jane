        { "id": "pa1.u04.l01.e02", "type": "picture_choice", "mode": "word-to-picture", "word": "seven", "distractors": ["six", "eight"], "hint": "Это число между шестью и восемью.", "explanation": "Seven — «семь». Ударение на первый слог: SE-ven." },
        { "id": "pa1.u04.l01.e03", "type": "translate_choice", "from": "en", "text": "three", "options": ["три", "два", "десять"], "answer": 0, "hint": "Слово начинается со звука th: язык между зубами.", "explanation": "Three — «три». Th [θ] — язык между зубами.", "troubles": ["pron-th"] },
        { "id": "pa1.u04.l01.e04", "type": "translate_choice", "from": "ru", "text": "восемь", "options": ["eight", "nine", "ten"], "answer": 0, "hint": "Слово читается «эйт».", "explanation": "Eight — «восемь»: [eɪt]. Буквы gh не читаются." },
        { "id": "pa1.u04.l01.e05", "type": "match_pairs", "pairs": [{ "en": "one", "ru": "один" }, { "en": "two", "ru": "два" }, { "en": "four", "ru": "четыре" }, { "en": "six", "ru": "шесть" }, { "en": "ten", "ru": "десять" }], "hint": "Ten и six похожи по звучанию на русские «тэн» и «сикс».", "explanation": "One — «один», two — «два», four — «четыре», six — «шесть», ten — «десять»." },
        { "id": "pa1.u04.l01.e06", "type": "listen_choice", "audio": "nine", "question": "Какое число вы слышите?", "options": ["nine", "five", "one"], "answer": 0, "hint": "Слово начинается и заканчивается на «н».", "explanation": "Nine — «девять»: [naɪn]." },
        { "id": "pa1.u04.l01.e07", "type": "listen_choice", "audio": "two", "question": "Какое число вы слышите?", "options": ["two", "three", "ten"], "answer": 0, "hint": "Слышно только «т» и «у:».", "explanation": "Two — «два»: [tuː]. Буква w не читается." },
        { "id": "pa1.u04.l01.e08", "type": "listen_dictation", "text": "six", "hint": "Три буквы.", "explanation": "Six — «шесть»: s-i-x. Буква x читается как «кс»." },
        { "id": "pa1.u04.l01.e09", "type": "type_translation", "from": "ru", "text": "один", "answers": ["one"], "hint": "Три буквы, читается «уан».", "explanation": "One — «один». Читается не по буквам: [wʌn]." },
        { "id": "pa1.u04.l01.e10", "type": "fill_gap", "text": "One, two, ___, four.", "translation": "Один, два, три, четыре.", "answers": [["three"]], "options": ["three", "five", "ten"], "hint": "Число после two.", "explanation": "One, two, three, four — счёт по порядку." },
        { "id": "pa1.u04.l01.e11", "type": "fill_gap", "text": "Seven, eight, ___, ten.", "translation": "Семь, восемь, девять, десять.", "answers": [["nine"]], "options": ["nine", "four", "zero"], "hint": "Число между eight и ten.", "explanation": "Seven, eight, nine, ten — по порядку." },
        { "id": "pa1.u04.l01.e12", "type": "translate_choice", "from": "en", "text": "zero", "options": ["ноль", "один", "много"], "answer": 0, "hint": "Это число — ничего.", "explanation": "Zero — «ноль». Читается [ˈzɪroʊ]." },
        { "id": "pa1.u04.l01.e13", "type": "speak_repeat", "text": "One, two, three, four, five.", "hint": "Считайте ровно, без пауз.", "explanation": "Следите за звуками: one [wʌn], two [tuː], three [θriː] — язык между зубами." }
      ]
    },
