  "texts": [
    {
      "id": "pa1.u04.ages",
      "kind": "dialogue",
      "genre": "conversation",
      "title": { "en": "How old are you?", "ru": "Сколько вам лет?" },
      "speakers": [
        { "id": "anna", "name": "Anna", "voice": "female" },
        { "id": "tom", "name": "Tom", "voice": "male" }
      ],
      "lines": [
        { "speaker": "anna", "en": "Tom, how old are you?", "ru": "Том, сколько тебе лет?" },
        { "speaker": "tom", "en": "I am twenty. How old are you, Anna?", "ru": "Мне двадцать. А сколько лет тебе, Анна?" },
        { "speaker": "anna", "en": "I am nineteen.", "ru": "Мне девятнадцать." },
        { "speaker": "tom", "en": "Nineteen! And Max? How old is Max?", "ru": "Девятнадцать! А Макс? Сколько лет Максу?" },
        { "speaker": "anna", "en": "Max is twelve.", "ru": "Максу двенадцать." },
        { "speaker": "tom", "en": "Twelve years old! Hello, Max!", "ru": "Двенадцать лет! Привет, Макс!" }
      ]
    },
    {
      "id": "pa1.u04.poster",
      "kind": "reading",
      "genre": "article",
      "title": { "en": "Numbers poster", "ru": "Плакат с числами" },
      "lines": [
        { "en": "One, two, three, four, five. Six, seven, eight, nine, ten.", "ru": "Один, два, три, четыре, пять. Шесть, семь, восемь, девять, десять." },
        { "en": "Eleven, twelve, thirteen, fourteen, fifteen. Sixteen, seventeen, eighteen, nineteen, twenty.", "ru": "Одиннадцать, двенадцать, тринадцать, четырнадцать, пятнадцать. Шестнадцать, семнадцать, восемнадцать, девятнадцать, двадцать." }
      ]
    }
  ],
