        { "id": "pa1.u04.l02.e02", "type": "translate_choice", "from": "ru", "text": "двенадцать", "options": ["twelve", "eleven", "twenty"], "answer": 0, "hint": "Заканчивается на -lve.", "explanation": "Twelve — «двенадцать». Пишется twelve, а читается [twelv].", "grammar": ["pa1.numbers"] },
        { "id": "pa1.u04.l02.e03", "type": "match_pairs", "pairs": [{ "en": "thirteen", "ru": "тринадцать" }, { "en": "fourteen", "ru": "четырнадцать" }, { "en": "fifteen", "ru": "пятнадцать" }, { "en": "sixteen", "ru": "шестнадцать" }, { "en": "seventeen", "ru": "семнадцать" }], "hint": "У всех этих чисел окончание -teen.", "explanation": "Числа 13–19 оканчиваются на -teen: thirteen, fourteen, fifteen, sixteen, seventeen. Окончание ударное.", "grammar": ["pa1.numbers"] },
        { "id": "pa1.u04.l02.e04", "type": "match_pairs", "pairs": [{ "en": "eighteen", "ru": "восемнадцать" }, { "en": "nineteen", "ru": "девятнадцать" }, { "en": "twenty", "ru": "двадцать" }, { "en": "twelve", "ru": "двенадцать" }, { "en": "eleven", "ru": "одиннадцать" }], "hint": "Twenty и twelve начинаются одинаково.", "explanation": "Числа: eighteen — 18, nineteen — 19, twenty — 20, twelve — 12, eleven — 11.", "grammar": ["pa1.numbers"] },
        { "id": "pa1.u04.l02.e05", "type": "listen_choice", "audio": "fifteen", "question": "Какое число вы слышите?", "options": ["fifteen", "five", "fourteen"], "answer": 0, "hint": "Слово длинное, заканчивается на «и:н».", "explanation": "Fifteen [ˌfɪfˈtiːn] — «пятнадцать». Five [faɪv] — «пять».", "grammar": ["pa1.numbers"] },
        { "id": "pa1.u04.l02.e06", "type": "listen_choice", "audio": "seventeen", "question": "Какое число вы слышите?", "options": ["seventeen", "seven", "sixteen"], "answer": 0, "hint": "Слышно «сэвэн-ти:н».", "explanation": "Seventeen — «семнадцать». У seven окончания -teen нет.", "grammar": ["pa1.numbers"] },
        { "id": "pa1.u04.l02.e07", "type": "listen_dictation", "text": "nineteen", "hint": "Девять букв: nine и teen.", "explanation": "Nineteen — «девятнадцать»: nine + teen." },
        { "id": "pa1.u04.l02.e08", "type": "minimal_pair", "pair": [{ "en": "thirteen", "ipa": "ˌθɝːˈtiːn" }, { "en": "thirty", "ipa": "ˈθɝːti" }], "say": 0, "hint": "В одном слове ударение на конце.", "explanation": "Thirteen — [thir-TEEN], ударение на последнем слоге. Thirty — [THIR-ty], ударение на первом. Так отличают 13 и 30.", "troubles": ["pron-th"] },
        { "id": "pa1.u04.l02.e09", "type": "minimal_pair", "pair": [{ "en": "three", "ipa": "θriː" }, { "en": "free", "ipa": "friː" }], "say": 0, "hint": "Первый звук — язык между зубами.", "explanation": "[θ] в three — язык между зубами. [f] в free — верхние зубы касаются нижней губы.", "troubles": ["pron-th"] },
        { "id": "pa1.u04.l02.e10", "type": "word_stress", "word": "thirteen", "syllables": ["thir", "teen"], "stress": 1, "hint": "Ударение на втором слоге.", "explanation": "thir-TEEN — ударение на -teen." },
        { "id": "pa1.u04.l02.e11", "type": "word_stress", "word": "twenty", "syllables": ["twen", "ty"], "stress": 0, "hint": "Громче и дольше первый слог.", "explanation": "TWEN-ty — ударение на первый слог." },
        { "id": "pa1.u04.l02.e12", "type": "word_stress", "word": "eleven", "syllables": ["e", "lev", "en"], "stress": 1, "hint": "Ударный слог — средний.", "explanation": "e-LE-ven — ударение на второй слог." },
        { "id": "pa1.u04.l02.e13", "type": "speak_repeat", "text": "Thirteen, fourteen, fifteen.", "hint": "В каждом слове ударение на -teen: thir-TEEN.", "explanation": "Thir-TEEN, four-TEEN, fif-TEEN: окончание -teen долгое и ударное.", "troubles": ["pron-th"] },
        { "id": "pa1.u04.l02.e14", "type": "speak_repeat", "text": "Eighteen, nineteen, twenty.", "hint": "Ударение: eigh-TEEN, nine-TEEN, TWEN-ty.", "explanation": "В -teen ударение на конце, в twenty — на начале." }
      ]
    },
