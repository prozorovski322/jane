          "explanation": "Тому двадцать лет, Анне девятнадцать, а Максу двенадцать.",
          "questions": [
            { "kind": "mcq", "question": "Сколько лет Анне?", "options": ["nineteen", "twenty", "twelve"], "answer": 0, "explanation": "Анна говорит: I am nineteen." },
            { "kind": "mcq", "question": "Сколько лет Тому?", "options": ["twenty", "nineteen", "twelve"], "answer": 0, "explanation": "Том говорит: I am twenty." },
            { "kind": "mcq", "question": "Сколько лет Максу?", "options": ["twelve", "twenty", "nine"], "answer": 0, "explanation": "Анна говорит: Max is twelve." },
