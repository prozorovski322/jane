        { "id": "pa1.u04.l03.e04", "type": "fill_gap", "text": "How ___ are you?", "translation": "Сколько тебе лет?", "answers": [["old"]], "options": ["old", "many", "number"], "hint": "О возрасте спрашивают со словом «старый».", "explanation": "How old are you? — «Сколько тебе лет?». Old — «старый».", "grammar": ["pa1.numbers"] },
