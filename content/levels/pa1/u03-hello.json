            { "kind": "mcq", "question": "Как зовут второго человека?", "options": ["Tom", "Max", "Li"], "answer": 0, "explanation": "Второй человек говорит: My name is Tom." },
            { "kind": "tfn", "statement": "Tom: yes.", "answer": "false", "explanation": "Анна спрашивает: Are you Max? Том отвечает: No, I am Tom." },
            { "kind": "tfn", "statement": "Anna: sorry.", "answer": "true", "explanation": "Анна говорит: Sorry, Tom!" },
            { "kind": "tfn", "statement": "Tom: good night.", "answer": "not_given", "explanation": "Слов good night в диалоге нет: Том говорит goodbye." }
          ]
        },
        { "id": "pa1.u03.l03.e02", "type": "listen_choice", "audio": "My name is Tom.", "question": "Что вы слышите?", "options": ["My name is Tom.", "I am Tom.", "Your name is Tom."], "answer": 0, "hint": "Первое слово — my, «мой».", "explanation": "My name is Tom — «меня зовут Том». I am Tom — тоже правильно, но это другая фраза." },
        { "id": "pa1.u03.l03.e03", "type": "listen_dictation", "text": "What is your name?", "answers": ["What's your name?"], "hint": "Четыре слова.", "explanation": "What is your name? — «Как вас зовут?». Короткая форма: What's your name?" },
        { "id": "pa1.u03.l03.e04", "type": "listen_dictation", "text": "I am Anna.", "answers": ["I'm Anna."], "hint": "Три слова, последнее — имя.", "explanation": "I am Anna — «я Анна». Короткая форма: I'm Anna." },
        { "id": "pa1.u03.l03.e05", "type": "fill_gap", "text": "Hello, Anna! ___ name is Tom.", "translation": "Здравствуйте, Анна! Меня зовут Том.", "answers": [["My"]], "options": ["My", "Your", "You"], "hint": "Том говорит о себе.", "explanation": "My name is Tom: my — «мой». Your name — «ваше имя».", "grammar": ["pa1.i-am"] },
        { "id": "pa1.u03.l03.e06", "type": "fill_gap", "text": "Are you Max? — No, I ___ Tom.", "translation": "Вы Макс? — Нет, я Том.", "answers": [["am"]], "options": ["am", "are", "is"], "hint": "Том говорит о себе.", "explanation": "No, I am Tom — «нет, я Том». С I — am.", "grammar": ["pa1.i-am"] },
        { "id": "pa1.u03.l03.e07", "type": "minimal_pair", "pair": [{ "en": "thank", "ipa": "θæŋk" }, { "en": "tank", "ipa": "tæŋk" }], "say": 0, "hint": "В слове thank язык между зубами.", "explanation": "[θ] в thank — язык между зубами, воздух проходит мягко. [t] в tank — язык за зубами. Заменять th на «с» или «т» — самая частая ошибка русскоговорящих.", "troubles": ["pron-th"] },
        { "id": "pa1.u03.l03.e08", "type": "speak_repeat", "text": "Thank you, Anna!", "hint": "В thank язык между зубами, не «сэнк».", "explanation": "Th [θ] — глухой звук: кончик языка между зубами, выдыхайте воздух.", "troubles": ["pron-th"] },
        { "id": "pa1.u03.l03.e09", "type": "speak_answer", "question": "What is your name?", "questionRu": "Как вас зовут? Ответьте полным предложением.", "keywords": [["\\bmy name('s| is)\\b", "\\bI'?m\\b", "\\bI am\\b"]], "minKeywords": 1, "samples": ["My name is Olga.", "I am Max."], "difficulty": 3, "hint": "My name is… или I am…", "explanation": "Оба варианта правильные: My name is Olga и I am Olga. Второй звучит проще.", "grammar": ["pa1.i-am"] },
        { "id": "pa1.u03.l03.e10", "type": "type_translation", "from": "ru", "text": "Да, я Том.", "answers": ["Yes, I am Tom.", "Yes, I'm Tom."], "hint": "Yes — да.", "explanation": "Yes, I am Tom. Yes — «да», потом I am и имя.", "grammar": ["pa1.i-am"] },
        { "id": "pa1.u03.l03.e11", "type": "type_translation", "from": "ru", "text": "Нет, я Макс.", "answers": ["No, I am Max.", "No, I'm Max."], "hint": "No — нет.", "explanation": "No, I am Max. No — «нет».", "grammar": ["pa1.i-am"] }
      ]
