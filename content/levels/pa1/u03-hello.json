  "texts": [
    {
      "id": "pa1.u03.hello-anna",
      "kind": "dialogue",
      "genre": "conversation",
      "title": { "en": "Hello, Anna!", "ru": "Здравствуйте, Анна!" },
      "speakers": [
        { "id": "anna", "name": "Anna", "voice": "female" },
        { "id": "tom", "name": "Tom", "voice": "male" }
      ],
      "lines": [
        { "speaker": "anna", "en": "Good morning! I am Anna.", "ru": "Доброе утро! Я Анна." },
        { "speaker": "tom", "en": "Hello, Anna! My name is Tom.", "ru": "Здравствуйте, Анна! Меня зовут Том." },
        { "speaker": "anna", "en": "Hi, Tom! Are you Max?", "ru": "Привет, Том! Вы Макс?" },
        { "speaker": "tom", "en": "No, I am Tom.", "ru": "Нет, я Том." },
        { "speaker": "anna", "en": "Sorry, Tom! Thank you.", "ru": "Извините, Том! Спасибо." },
        { "speaker": "tom", "en": "Goodbye, Anna!", "ru": "До свидания, Анна!" },
        { "speaker": "anna", "en": "Bye, Tom!", "ru": "Пока, Том!" }
      ]
    },
    {
      "id": "pa1.u03.names",
      "kind": "reading",
      "genre": "profile",
      "title": { "en": "Name cards", "ru": "Карточки с именами" },
      "lines": [
        { "en": "Hello! I am Max. My name is Max.", "ru": "Здравствуйте! Я Макс. Меня зовут Макс." },
        { "en": "Hi! I am Olga. My name is Olga. And you? What is your name?", "ru": "Привет! Я Ольга. Меня зовут Ольга. А вы? Как вас зовут?" },
        { "en": "Good night, Olga! Bye!", "ru": "Спокойной ночи, Ольга! Пока!" }
      ]
    }
  ],
  "lessons": [
    {
      "id": "pa1.u03.l01",
      "kind": "vocabulary",
      "title": "Здравствуйте и до свидания",
      "exercises": [
        { "id": "pa1.u03.l01.e01", "type": "picture_choice", "mode": "picture-to-word", "word": "hello", "distractors": ["good-night", "good-morning"], "hint": "Этим жестом машут при встрече.", "explanation": "Hello — «привет, здравствуйте». Подходит для любого времени дня." },
        { "id": "pa1.u03.l01.e02", "type": "picture_choice", "mode": "word-to-picture", "word": "good-night", "distractors": ["hello", "good-morning"], "hint": "Так желают перед сном.", "explanation": "Good night — «спокойной ночи». Так прощаются вечером, а не здороваются." },
        { "id": "pa1.u03.l01.e03", "type": "translate_choice", "from": "en", "text": "Good morning!", "options": ["Доброе утро!", "Добрый вечер!", "Спокойной ночи!"], "answer": 0, "hint": "Morning — утро.", "explanation": "Good morning — приветствие утром. Good evening — вечером, good night — перед сном." },
        { "id": "pa1.u03.l01.e04", "type": "translate_choice", "from": "ru", "text": "Пока!", "options": ["Bye!", "Hi!", "Please!"], "answer": 0, "hint": "Так прощаются с друзьями.", "explanation": "Bye — «пока». Hi — «привет» при встрече." },
        { "id": "pa1.u03.l01.e05", "type": "match_pairs", "pairs": [{ "en": "hello", "ru": "здравствуйте" }, { "en": "goodbye", "ru": "до свидания" }, { "en": "thanks", "ru": "спасибо" }, { "en": "sorry", "ru": "извините" }, { "en": "please", "ru": "пожалуйста" }], "hint": "Начните с самых знакомых слов.", "explanation": "Please — «пожалуйста», когда о чём-то просите. Sorry — «извините», когда извиняетесь." },
        { "id": "pa1.u03.l01.e06", "type": "match_pairs", "pairs": [{ "en": "yes", "ru": "да" }, { "en": "no", "ru": "нет" }, { "en": "hi", "ru": "привет" }, { "en": "bye", "ru": "пока" }, { "en": "thank you", "ru": "спасибо" }], "hint": "Yes и no — самые короткие ответы.", "explanation": "Yes — «да», no — «нет». Hi и bye — разговорные приветствие и прощание." },
        { "id": "pa1.u03.l01.e07", "type": "listen_choice", "audio": "Good evening!", "question": "Что вы слышите?", "options": ["Good evening!", "Good morning!", "Good night!"], "answer": 0, "hint": "Слышно слово evening.", "explanation": "Good evening — «добрый вечер». Так здороваются вечером." },
        { "id": "pa1.u03.l01.e08", "type": "listen_choice", "audio": "Thank you!", "question": "Что вы слышите?", "options": ["Thank you!", "Sorry!", "Please!"], "answer": 0, "hint": "Начинается со звука th: язык между зубами.", "explanation": "Thank you — «спасибо». В слове thank язык кладут между зубами: [θ].", "troubles": ["pron-th"] },
        { "id": "pa1.u03.l01.e09", "type": "tiles", "from": "ru", "text": "Спокойной ночи!", "answer": "Good night!", "distractors": ["morning", "bye"], "hint": "Два слова: хороший и ночь.", "explanation": "Good night — «спокойной ночи». Так говорят, когда прощаются на ночь." },
        { "id": "pa1.u03.l01.e10", "type": "type_translation", "from": "ru", "text": "Спасибо!", "answers": ["Thank you!", "Thanks!"], "hint": "Короткий или полный вариант.", "explanation": "Thanks и thank you — оба «спасибо». Thank you звучит чуть вежливее.", "troubles": ["pron-th"] },
        { "id": "pa1.u03.l01.e11", "type": "fill_gap", "text": "Good ___, Anna!", "translation": "Добрый вечер, Анна!", "answers": [["evening"]], "options": ["evening", "bye", "yes"], "hint": "Так здороваются вечером.", "explanation": "Good evening — «добрый вечер». После good стоит время суток." },
        { "id": "pa1.u03.l01.e12", "type": "type_translation", "from": "ru", "text": "Извините!", "answers": ["Sorry!"], "hint": "Пять букв, начинается с s.", "explanation": "Sorry — «извините»: когда вы извиняетесь." },
        { "id": "pa1.u03.l01.e13", "type": "speak_repeat", "text": "Good morning! Hello!", "hint": "Говорите слитно: good-MORN-ing.", "explanation": "В good morning ударение на morn: good-MORN-ing. Hello — he-LLO, ударение на втором слоге." }
      ]
    },
    {
      "id": "pa1.u03.l02",
      "kind": "grammar",
      "title": "Я — I am, ты — you are",
      "grammar": "pa1.i-am",
      "exercises": [
        { "id": "pa1.u03.l02.e01", "type": "translate_choice", "from": "en", "text": "I am Anna.", "options": ["Я Анна.", "Ты Анна.", "Это Анна."], "answer": 0, "hint": "I — это «я».", "explanation": "I am Anna — «я Анна». I am — сокращённо I'm.", "grammar": ["pa1.i-am"] },
        { "id": "pa1.u03.l02.e02", "type": "translate_choice", "from": "en", "text": "You are Tom.", "options": ["Ты Том.", "Я Том.", "Он Том."], "answer": 0, "hint": "You — «ты» или «вы».", "explanation": "You are Tom — «ты Том». You are — сокращённо you're.", "grammar": ["pa1.i-am"] },
        { "id": "pa1.u03.l02.e03", "type": "fill_gap", "text": "I ___ Anna.", "translation": "Я Анна.", "answers": [["am"]], "options": ["am", "is", "are"], "hint": "С I всегда одна и та же форма.", "explanation": "I am Anna. Am бывает только с I.", "grammar": ["pa1.i-am"] },
        { "id": "pa1.u03.l02.e04", "type": "fill_gap", "text": "You ___ Tom.", "translation": "Ты Том.", "answers": [["are"]], "options": ["am", "is", "are"], "hint": "С you — особая форма.", "explanation": "You are Tom. С you всегда are.", "grammar": ["pa1.i-am"] },
        { "id": "pa1.u03.l02.e05", "type": "fill_gap", "text": "My name ___ Max.", "translation": "Меня зовут Макс.", "answers": [["is"]], "options": ["am", "is", "are"], "hint": "Name — одно имя, как «это».", "explanation": "My name is Max. Для одного имени — is.", "grammar": ["pa1.i-am"] },
        { "id": "pa1.u03.l02.e06", "type": "error_correction", "text": "I Anna.", "wrong": "I", "correction": "I am", "options": ["I am", "I is", "I are"], "hint": "В предложении не хватает глагола.", "explanation": "По-русски «Я Анна» — без глагола. По-английски нужен am: I am Anna.", "grammar": ["pa1.i-am"], "troubles": ["word-order"] },
        { "id": "pa1.u03.l02.e07", "type": "error_correction", "text": "My name am Tom.", "wrong": "am", "correction": "is", "options": ["is", "are", "be"], "hint": "Для одного имени используется другая форма.", "explanation": "My name is Tom. Am бывает только с I.", "grammar": ["pa1.i-am"] },
        { "id": "pa1.u03.l02.e08", "type": "error_correction", "text": "You is Max.", "wrong": "is", "correction": "are", "options": ["are", "am", "be"], "hint": "С you всегда одна и та же форма.", "explanation": "You are Max. С you — are.", "grammar": ["pa1.i-am"] },
        { "id": "pa1.u03.l02.e09", "type": "tiles", "from": "ru", "text": "Меня зовут Ольга.", "answer": "My name is Olga.", "distractors": ["am", "your"], "hint": "Дословно: «моё имя есть Ольга».", "explanation": "My name is Olga — так по-английски говорят «меня зовут Ольга».", "grammar": ["pa1.i-am"] },
        { "id": "pa1.u03.l02.e10", "type": "tiles", "from": "ru", "text": "Как тебя зовут?", "answer": "What is your name?", "distractors": ["my", "am"], "hint": "Дословно: «что есть твоё имя?»", "explanation": "What is your name? — «Как тебя зовут?». Your стоит перед name.", "grammar": ["pa1.i-am"] },
        { "id": "pa1.u03.l02.e11", "type": "type_translation", "from": "ru", "text": "Я Том.", "answers": ["I am Tom.", "I'm Tom."], "hint": "Нужен глагол am.", "explanation": "I am Tom (I'm Tom). Глагол обязателен, хотя по-русски его нет.", "grammar": ["pa1.i-am"] },
        { "id": "pa1.u03.l02.e12", "type": "type_translation", "from": "ru", "text": "Вы Анна?", "answers": ["Are you Anna?"], "difficulty": 2, "hint": "В вопросе глагол стоит перед you.", "explanation": "Are you Anna? В вопросе are идёт первым, а потом you.", "grammar": ["pa1.i-am"], "troubles": ["word-order"] }
      ]
    },
    {
