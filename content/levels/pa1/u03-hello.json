{
  "id": "pa1.u03",
  "level": "PA1",
  "order": 3,
  "title": { "en": "Hello and please", "ru": "Приветствия и вежливость" },
  "description": "Здороваемся и прощаемся, благодарим и извиняемся. Говорим, как нас зовут, и спрашиваем имя: I am…, My name is…, What is your name?",
  "goals": [
    "Могу поздороваться и попрощаться в разное время дня.",
    "Могу поблагодарить, попросить и извиниться.",
    "Могу сказать, как меня зовут, и спросить имя собеседника.",
    "Могу ответить «да» и «нет» и понять простой диалог при знакомстве.",
    "Могу написать короткое приветствие со своим именем."
  ],
  "grammar": ["pa1.i-am"],
  "troubles": ["word-order", "pron-th"],
  "words": [
{ "id": "hello", "en": "hello", "ipa": "həˈloʊ", "pos": "interj", "ru": ["привет", "здравствуйте"], "example": { "en": "Hello! I'm Anna.", "ru": "Здравствуйте! Я Анна." }, "picture": { "emoji": "👋" }, "topics": ["greetings"] },
    { "id": "hi", "en": "hi", "ipa": "haɪ", "pos": "interj", "ru": ["привет"], "example": { "en": "Hi, Tom!", "ru": "Привет, Том!" }, "note": "Hi — неформальное приветствие, hello подходит для любой ситуации.", "topics": ["greetings"] },
    { "id": "goodbye", "en": "goodbye", "ipa": "ɡʊdˈbaɪ", "pos": "interj", "ru": ["до свидания"], "example": { "en": "Goodbye, Anna!", "ru": "До свидания, Анна!" }, "topics": ["greetings"] },
    { "id": "bye", "en": "bye", "ipa": "baɪ", "pos": "interj", "ru": ["пока"], "example": { "en": "Bye, Tom!", "ru": "Пока, Том!" }, "topics": ["greetings"] },
    { "id": "good-morning", "en": "good morning", "ipa": "ɡʊd ˈmɔːrnɪŋ", "pos": "phrase", "ru": ["доброе утро"], "example": { "en": "Good morning, Anna!", "ru": "Доброе утро, Анна!" }, "picture": { "emoji": "🌅" }, "topics": ["greetings"] },
    { "id": "good-evening", "en": "good evening", "ipa": "ɡʊd ˈiːvnɪŋ", "pos": "phrase", "ru": ["добрый вечер"], "example": { "en": "Good evening! I'm Ivan.", "ru": "Добрый вечер! Я Иван." }, "topics": ["greetings"] },
    { "id": "good-night", "en": "good night", "ipa": "ɡʊd naɪt", "pos": "phrase", "ru": ["спокойной ночи"], "example": { "en": "Good night, Kate!", "ru": "Спокойной ночи, Кейт!" }, "note": "Это прощание, а не приветствие. Вечером при встрече говорят good evening.", "picture": { "emoji": "🌙" }, "topics": ["greetings"] },
    { "id": "thanks", "en": "thanks", "ipa": "θæŋks", "pos": "interj", "ru": ["спасибо"], "example": { "en": "Thanks, Anna!", "ru": "Спасибо, Анна!" }, "troubles": ["pron-th"], "topics": ["greetings"] },
    { "id": "thank-you", "en": "thank you", "ipa": "θæŋk juː", "pos": "phrase", "ru": ["спасибо"], "example": { "en": "Thank you, Max!", "ru": "Спасибо, Макс!" }, "note": "Thank you звучит чуть вежливее, чем thanks.", "troubles": ["pron-th"], "topics": ["greetings"] },
    { "id": "please", "en": "please", "ipa": "pliːz", "pos": "adv", "ru": ["пожалуйста (при просьбе)"], "example": { "en": "Your name, please?", "ru": "Ваше имя, пожалуйста?" }, "note": "Только для просьбы. В ответ на «спасибо» please не говорят." },
    { "id": "sorry", "en": "sorry", "ipa": "ˈsɑːri", "pos": "adj", "ru": ["извините", "простите"], "example": { "en": "Sorry, Tom!", "ru": "Извините, Том!" }, "note": "Sorry — когда извиняетесь. Чтобы обратиться к незнакомому человеку, говорят excuse me." },
    { "id": "yes", "en": "yes", "ipa": "jes", "pos": "adv", "ru": ["да"], "example": { "en": "Yes, I'm Max.", "ru": "Да, я Макс." } },
    { "id": "no", "en": "no", "ipa": "noʊ", "pos": "adv", "ru": ["нет"], "example": { "en": "No, I'm Tom.", "ru": "Нет, я Том." } },
    { "id": "i", "en": "I", "ipa": "aɪ", "pos": "pron", "ru": ["я"], "example": { "en": "I'm Anna.", "ru": "Я Анна." }, "note": "Всегда пишется с большой буквы." },
    { "id": "you", "en": "you", "ipa": "juː", "pos": "pron", "ru": ["ты", "вы"], "example": { "en": "You are Tom.", "ru": "Ты Том." } },
