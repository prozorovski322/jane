    { "id": "your", "en": "your", "ipa": "jʊr", "pos": "det", "ru": ["твой", "ваш"], "example": { "en": "What's your name?", "ru": "Как тебя зовут?" } },
    { "id": "name", "en": "name", "ipa": "neɪm", "pos": "noun", "ru": ["имя"], "example": { "en": "My name is Max.", "ru": "Меня зовут Макс." }, "note": "My name is… — дословно «моё имя…», по-русски «меня зовут…»." },
    { "id": "what", "en": "what", "ipa": "wʌt", "pos": "pron", "ru": ["что", "какой"], "example": { "en": "What's your name?", "ru": "Как вас зовут?" } },
    { "id": "be", "en": "be", "ipa": "biː", "pos": "verb", "ru": ["быть", "являться"], "example": { "en": "I am Tom. You are Anna.", "ru": "Я Том. Ты Анна." }, "note": "Формы в настоящем: I am, he/she/it is, you/we/they are." },
    { "id": "and", "en": "and", "ipa": "ænd", "pos": "conj", "ru": ["и", "а"], "example": { "en": "Tom and Anna.", "ru": "Том и Анна." } }
